% layout 'default';
% title t('auth.passkey_title') . ' - ' . t('app.name');
<section class="account-panel" aria-labelledby="passkey-heading">
  <h1 id="passkey-heading"><%= t('auth.passkey_title') %></h1>
  <p><%= t('auth.passkey_description') %></p>
  % if (!$enabled) {
    <p role="status"><%= t('auth.passkey_unavailable') %></p>
  % } else {
    <form method="post" action="<%= ui_path('passkey_register_begin') %>" data-passkey="register"
      data-finish="<%= ui_path('passkey_register_finish') %>"
      data-failed="<%= t('auth.passkey_failed') %>" data-unsupported="<%= t('auth.passkey_unsupported') %>"
      data-cancelled="<%= t('auth.passkey_cancelled') %>" data-waiting="<%= t('auth.passkey_waiting') %>">
      <%= csrf_field %>
      <label for="passkey-label"><%= t('auth.passkey_label') %></label>
      <input id="passkey-label" name="label" maxlength="100" required>
      <label for="passkey-password"><%= t('auth.oidc_password') %></label>
      <input id="passkey-password" name="password" type="password" autocomplete="current-password" required>
      <label for="passkey-code"><%= t('auth.oidc_code') %></label>
      <input id="passkey-code" name="code" autocomplete="one-time-code">
      <button type="submit" disabled><%= t('auth.passkey_add') %></button>
      <button type="button" data-passkey-cancel hidden><%= t('auth.passkey_cancel') %></button>
      <p data-passkey-status role="status" aria-live="polite"></p>
      <noscript><p><%= t('auth.passkey_unsupported') %></p></noscript>
    </form>
    <h2><%= t('auth.passkey_saved') %></h2>
    % if (!@{$passkeys}) {
      <p><%= t('auth.passkey_empty') %></p>
    % }
    % for my $key (@{$passkeys}) {
      <section aria-label="<%= $key->{label} %>">
        <h3><%= $key->{label} %></h3>
        <form method="post" action="<%= ui_path('passkey_revoke', passkey_id => $key->{id}) %>">
          <%= csrf_field %>
          <label for="passkey-password-<%= $key->{id} %>"><%= t('auth.oidc_password') %></label>
          <input id="passkey-password-<%= $key->{id} %>" name="password" type="password" autocomplete="current-password" required>
          <label for="passkey-code-<%= $key->{id} %>"><%= t('auth.oidc_code') %></label>
          <input id="passkey-code-<%= $key->{id} %>" name="code" autocomplete="one-time-code">
          <button type="submit"><%= t('auth.passkey_remove') %></button>
        </form>
      </section>
    % }
  % }
  <p><a href="<%= ui_path('settings_security') %>"><%= t('auth.second_factor_title') %></a> · <a href="<%= ui_path('settings') %>"><%= t('settings.title') %></a></p>
</section>
