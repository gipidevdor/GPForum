% layout 'default';
% title t('settings.title') . ' - ' . t('app.name');

<section aria-labelledby="<%= $ui->{heading_id} %>">
  <%= include 'components/page_header',
    heading_id => $ui->{heading_id},
    component_title => t('settings.title'),
    description => t('settings.description') %>

  <section class="settings-group" aria-labelledby="<%= $ui->{profile_heading_id} %>">
    <h2 id="<%= $ui->{profile_heading_id} %>"><%= t('settings.profile') %></h2>
    <form method="post" action="<%= ui_path('settings_profile_update') %>">
      <%= csrf_field %>
      <input type="hidden" name="command_id" value="<%= $profile_command_id || q{} %>">
      <label for="settings-bio"><%= t('settings.bio') %></label>
      <textarea id="settings-bio" name="bio" rows="4" maxlength="500" aria-describedby="settings-bio-help"><%= $bio %></textarea>
      <p id="settings-bio-help" class="ui-hint"><%= t('settings.bio_hint') %></p>
      <button type="submit"><%= t('settings.save_profile') %></button>
    </form>
  </section>
  <form class="settings-form" method="post" action="<%= ui_path('settings_update') %>">
    <%= csrf_field %>
    <input type="hidden" name="command_id" value="<%= $settings_command_id || q{} %>">

    <section class="settings-group" aria-labelledby="<%= $ui->{appearance_heading_id} %>">
      <h2 id="<%= $ui->{appearance_heading_id} %>"><%= t('settings.appearance') %></h2>
      <label for="settings-locale">
        <span><%= t('locale.choose') %></span>
        <select id="settings-locale" name="locale">
          % for my $option (@{$locale_options}) {
            <option value="<%= $option->{locale} %>"<%= $option->{current} ? ' selected' : '' %>><%= $option->{native_name} %></option>
          % }
        </select>
      </label>
      <label for="settings-theme">
        <span><%= t('theme.choose') %></span>
        <select id="settings-theme" name="theme">
          % for my $option (@{$theme_options}) {
            <option value="<%= $option->{name} %>"<%= $option->{current} ? ' selected' : '' %>><%= $option->{label} %></option>
          % }
        </select>
      </label>
      <label for="settings-timezone">
        <span><%= t('settings.timezone') %></span>
        <select id="settings-timezone" name="timezone" aria-describedby="settings-timezone-help">
          % for my $option (@{$timezone_options}) {
            <option value="<%= $option->{value} %>"<%= $option->{current} ? ' selected' : '' %>><%= $option->{label} %></option>
          % }
        </select>
      </label>
      <p id="settings-timezone-help"><%= t('settings.timezone_help') %></p>
    </section>

    <section class="settings-group" aria-labelledby="<%= $ui->{notifications_heading_id} %>">
      <h2 id="<%= $ui->{notifications_heading_id} %>"><%= t('settings.notifications') %></h2>
      <p><%= t('settings.notifications_description') %></p>
      <fieldset>
        <legend><%= t('settings.notification_channels') %></legend>
        % for my $preference (@{$notification_preferences}) {
          % my $channel = $preference->{channel};
          <section aria-labelledby="settings-notification-<%= $channel %>-heading">
            <div class="checkbox-field">
              <input id="settings-notification-<%= $channel %>-enabled" name="notification_<%= $channel %>_enabled" type="checkbox" value="1"<%= $preference->{enabled} ? ' checked' : '' %>>
              <label for="settings-notification-<%= $channel %>-enabled">
                <span id="settings-notification-<%= $channel %>-heading"><%= t($preference->{label_key}) %></span>
                <span><%= t($preference->{description_key}) %></span>
              </label>
            </div>
            <label for="settings-notification-<%= $channel %>-digest-frequency">
              <span><%= t('notifications.digest_frequency') %></span>
              <select id="settings-notification-<%= $channel %>-digest-frequency" name="notification_<%= $channel %>_digest_frequency">
                % for my $option (@{$digest_frequency_options}) {
                  <option value="<%= $option->{value} %>"<%= $option->{value} eq $preference->{digest_frequency} ? ' selected' : '' %>><%= t($option->{label_key}) %></option>
                % }
              </select>
            </label>
          </section>
        % }
      </fieldset>
      <fieldset aria-describedby="settings-notification-kinds-help">
        <legend><%= t('settings.notification_kinds') %></legend>
        <p id="settings-notification-kinds-help" class="ui-hint"><%= t('settings.notification_kinds_help') %></p>
        <input type="hidden" name="notification_types_present" value="1">
        % for my $kind (@{$notification_type_preferences}) {
          % my $type = $kind->{event_type};
          <section aria-labelledby="settings-notification-kind-<%= $type %>-heading" aria-describedby="settings-notification-kind-<%= $type %>-description">
            <h3 id="settings-notification-kind-<%= $type %>-heading"><%= t($kind->{label_key}) %></h3>
            <p id="settings-notification-kind-<%= $type %>-description"><%= t($kind->{description_key}) %></p>
            % for my $choice (@{ $kind->{channels} }) {
              % my $field = 'notification_type_' . $type . '_' . $choice->{channel};
              <div class="checkbox-field">
                <input id="settings-<%= $field %>" name="<%= $field %>" type="checkbox" value="1"<%= $choice->{enabled} ? ' checked' : '' %>>
                <label for="settings-<%= $field %>"><%= t($choice->{label_key}) %></label>
              </div>
            % }
          </section>
        % }
      </fieldset>
    </section>

    <button type="submit"><%= t('settings.save') %></button>
  </form>

  <section class="settings-group" aria-labelledby="<%= $ui->{credentials_heading_id} %>">
    <h2 id="<%= $ui->{credentials_heading_id} %>"><%= t('settings.credentials') %></h2>
    <form method="post" action="<%= ui_path('settings_password_update') %>">
      <%= csrf_field %>
      <input type="hidden" name="command_id" value="<%= $password_command_id || q{} %>">
      <label for="settings-current-password"><%= t('auth.current_password') %></label>
      <input id="settings-current-password" name="current_password" type="password" autocomplete="current-password">
      <label for="settings-new-password"><%= t('auth.new_password') %></label>
      <input id="settings-new-password" name="new_password" type="password" autocomplete="new-password">
      <button type="submit"><%= t('settings.change_password') %></button>
    </form>
  </section>

  <section class="settings-group" aria-labelledby="settings-data-heading">
    <h2 id="settings-data-heading"><%= t('nav.your_data') %></h2>
    <p><%= t('settings.your_data_description') %></p>
    <p><a href="<%= ui_path('privacy_dashboard') %>"><%= t('settings.your_data_open') %></a></p>
  </section>

  <section class="settings-group" aria-labelledby="settings-second-factor-heading">
    <h2 id="settings-second-factor-heading"><%= t('auth.second_factor_title') %></h2>
    <p><%= t('auth.second_factor_settings_description') %></p>
    <p><a href="<%= ui_path('settings_security') %>"><%= t('auth.second_factor_settings_open') %></a></p>
  </section>

  <section class="settings-group" aria-labelledby="settings-avatar-heading">
    <h2 id="settings-avatar-heading"><%= t('avatar.title') %></h2>
    <p><%= t('avatar.settings_description') %></p>
    <p><a href="<%= ui_path('settings_avatar') %>"><%= t('avatar.settings_open') %></a></p>
  </section>

  <section class="settings-group" aria-labelledby="settings-relations-heading">
    <h2 id="settings-relations-heading"><%= t('community.relation_page_title') %></h2>
    <p><%= t('community.relation_settings_description') %></p>
    <p><a href="<%= ui_path('member_relations') %>"><%= t('community.relation_settings_open') %></a></p>
  </section>

  <section class="settings-group" aria-labelledby="<%= $ui->{email_heading_id} %>">
    <h2 id="<%= $ui->{email_heading_id} %>"><%= t('settings.email') %></h2>
    <form method="post" action="<%= ui_path('settings_email_update') %>">
      <%= csrf_field %>
      <input type="hidden" name="command_id" value="<%= $email_command_id || q{} %>">
      <label for="settings-email"><%= t('auth.email') %></label>
      <input id="settings-email" name="email" type="email" autocomplete="email">
      <label for="settings-email-current-password"><%= t('auth.current_password') %></label>
      <input id="settings-email-current-password" name="current_password" type="password" autocomplete="current-password">
      <button type="submit"><%= t('settings.change_email') %></button>
    </form>
  </section>
</section>
