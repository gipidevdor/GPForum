msgctxt "auth.passkey_failed"
msgid "The passkey request could not be completed. Check your password and authenticator code when adding a key, then try again."
msgstr "Impossibile completare la richiesta della passkey. Per aggiungere una chiave, controlla la password e il codice dell’autenticatore, poi riprova."

msgctxt "auth.passkey_unsupported"
msgid "Passkeys require JavaScript, a compatible browser and HTTPS (or localhost)."
msgstr "Le passkey richiedono JavaScript, un browser compatibile e HTTPS (oppure localhost)."

msgctxt "auth.passkey_unavailable"
msgid "Passkeys need a configured public forum address with HTTPS (or localhost for development)."
msgstr "Le passkey richiedono un indirizzo pubblico del forum configurato con HTTPS (oppure localhost per lo sviluppo)."

msgctxt "auth.passkey_waiting"
msgid "Complete the passkey request on your device."
msgstr "Completa la richiesta della passkey sul tuo dispositivo."
