use v5.40;
our $VERSION = '0.001';
use FindBin;
use lib "$FindBin::Bin/lib";
use GPForum::Performance::WorkflowStatus;
try { exit GPForum::Performance::WorkflowStatus::main(@ARGV); }
catch ($error) {
    print {*STDERR} "performance-workflow-status: $error"
      or die "Cannot write diagnostic\n";
    exit 1;
};
