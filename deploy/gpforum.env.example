# Every setting GPForum reads, for its environment file.
#
# gpforum setup writes /etc/gpforum/gpforum.env (on FreeBSD,
# /usr/local/etc/gpforum/gpforum.env) with the settings under "Decide these",
# owned by root with group gpforum and mode 0640: it holds secrets. Copy a
# line from "Advanced" into it only to change that default, then restart the
# services that read it: systemctl restart gpforum gpforum-outbox. GPForum
# names every setting it cannot use, with an example, when it starts, and
# gpforum doctor checks the file.
#
# Write a value as it is when it holds only letters, digits and _ . / : @ , +
# % = -. Put any other value -- one with a space, $, a quote, a backslash, #
# or ; in it, as a password may have -- in double quotes, with a backslash
# before each " \ $ and `. systemd, the FreeBSD rc script's shell and gpforum
# then all read the same value:
#   GPFORUM_DATABASE_PASSWORD="my \$ecret \"pass\" word"
# reads my $ecret "pass" word. Left bare, systemd would read the whole line
# and a shell would stop at the first space and expand the $.
#
# This file is generated from the settings table in lib/GPForum/Config.pm,
# and t/463 keeps the two in step. To regenerate it:
#   script/gpforum-carton exec perl -Ilib -MGPForum::Config::EnvironmentFile \
#     -e 'print GPForum::Config::EnvironmentFile->render_reference' \
#     > deploy/gpforum.env.example

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
# Decide these
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

# Where this node runs: development, staging or production.
GPFORUM_ENV=production

# The address members reach the forum at, used in every link GPForum mails; https in production.
GPFORUM_PUBLIC_BASE_URL=https://forum.example.com

# Signs session cookies: a long random string, at least 32 characters in production.
# Generate one with: openssl rand -hex 32
GPFORUM_SESSION_SECRET=

# The PostgreSQL database, as a DBI data source; without host it uses the local Unix socket.
GPFORUM_DATABASE_DSN=dbi:Pg:dbname=gpforum

# The PostgreSQL role GPForum connects as.
GPFORUM_DATABASE_USER=gpforum

# That role's password; empty when PostgreSQL trusts the connection or ~/.pgpass holds it.
GPFORUM_DATABASE_PASSWORD=

# The token /metrics and the full /health/ready report ask for; required in staging and production.
# Generate one with: openssl rand -hex 32
GPFORUM_METRICS_TOKEN=

# How mail leaves: sendmail (the local mail server), smtp, or log (development only: writes it to the log).
GPFORUM_MAIL_TRANSPORT=sendmail

# The sender of every message: an address at the forum's own domain.
GPFORUM_MAIL_FROM=forum@forum.example.com

# How uploads are scanned: clamd, command or none.
GPFORUM_ANTIVIRUS=clamd

# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
# Advanced: the defaults suit most installations
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

# Application

# How much the log says: trace, debug, info, warn, error or fatal.
#GPFORUM_LOG_LEVEL=info

# A file to log to; empty logs to standard error, which systemd's journal keeps.
#GPFORUM_LOG_PATH=

# Where uploaded files are kept; a relative path starts at the code directory.
#GPFORUM_ATTACHMENT_ROOT=var/attachments

# Where new attachment bytes are stored.
#GPFORUM_ATTACHMENT_STORAGE=postgres

# Maximum audio or video size in MiB (100 to 250).
#GPFORUM_MEDIA_MAX_MIB=250

# Maximum retained source upload size per member in MiB; deleting an attachment does not release this allowance.
#GPFORUM_ATTACHMENT_OWNER_MAX_MIB=1024

# Maximum uploads awaiting a scan or content approval per member.
#GPFORUM_ATTACHMENT_OWNER_MAX_PENDING=20

# Exact HTTPS source hostnames approved for contributed media.
#GPFORUM_MEDIA_SOURCE_HOSTS=

# The internal path the proxy serves attachments from (X-Accel-Redirect); empty serves them from GPForum.
#GPFORUM_ATTACHMENT_ACCEL_REDIRECT=

# How profile pictures are cropped: system, the system's vipsthumbnail (sips on macOS), or none, which turns them off.
#GPFORUM_IMAGE_TOOL=system

# The language visitors see before they choose one, such as en or it.
#GPFORUM_DEFAULT_LOCALE=en

# The name of the forum, as its pages and mail say it.
#GPFORUM_SITE_NAME=Forum

# One line under the name on the home page; empty shows none.
#GPFORUM_SITE_DESCRIPTION=

# The theme visitors see before they choose one: auto, default, dark or high_contrast.
#GPFORUM_DEFAULT_THEME=auto

# Integration plugins, separated by commas; none disables all.
#GPFORUM_INTEGRATION_PLUGINS=

# Exact Mastodon instance hostnames authorized for link cards.
#GPFORUM_MASTODON_HOSTS=

# Exact PeerTube instance hostnames authorized for players.
#GPFORUM_PEERTUBE_HOSTS=

# Discord incoming webhook URL; empty disables announcements.
#GPFORUM_DISCORD_WEBHOOK=

# Exact HTTPS RSS or Atom URLs authorized for moderated imports.
#GPFORUM_SYNDICATION_SOURCES=

# Exact optional OpenID Connect issuer; empty disables external login.
#GPFORUM_OIDC_ISSUER=

# Pinned HTTPS OpenID authorization endpoint.
#GPFORUM_OIDC_AUTHORIZATION_ENDPOINT=

# Pinned HTTPS OpenID token endpoint.
#GPFORUM_OIDC_TOKEN_ENDPOINT=

# Pinned HTTPS OpenID signing-key endpoint.
#GPFORUM_OIDC_JWKS_URI=

# OpenID client id registered for this forum.
#GPFORUM_OIDC_CLIENT_ID=

# OpenID confidential client secret; never shown.
#GPFORUM_OIDC_CLIENT_SECRET=

# Pinned OpenID signing algorithm (RS256 or ES256).
#GPFORUM_OIDC_SIGNING_ALGORITHM=RS256

# The IANA time zone dates are shown in until a member chooses one.
#GPFORUM_DEFAULT_TIMEZONE=UTC

# Enable opt-in encrypted Web Push and its independent worker.
#GPFORUM_PUSH_ENABLED=off

# Maximum simultaneous Push sends per worker, capped at 64.
#GPFORUM_PUSH_CONCURRENCY=8

# Maximum simultaneous sends to one provider hostname per worker, capped at 16.
#GPFORUM_PUSH_PER_PROVIDER=2

# VAPID operator contact URI (mailto: or https:), required when Push is enabled.
#GPFORUM_PUSH_CONTACT=

# Trusted HTTPS WebSub hub managing callback verification, leases and delivery.
#GPFORUM_WEBSUB_HUB_URL=

# Legal and contacts

# The person or organisation that runs the forum, as the legal pages name it.
#GPFORUM_OPERATOR_NAME=

# The operator's postal address.
#GPFORUM_OPERATOR_ADDRESS=

# Where members and authorities write to the operator.
#GPFORUM_OPERATOR_EMAIL=

# VAT number, when the forum is run as an economic activity; empty shows none.
#GPFORUM_OPERATOR_VAT_NUMBER=

# Trade register and number, when the operator is entered in one; empty shows none.
#GPFORUM_OPERATOR_REGISTER=

# The data protection officer's address, when one is designated (GDPR art. 37).
#GPFORUM_PRIVACY_OFFICER_EMAIL=

# Where to report a vulnerability, as a mailto:, https: or tel: URI; empty uses the operator email.
#GPFORUM_SECURITY_CONTACT=

# Security

# Private Ed25519 PEM path, shared by workers and preserved across upgrades.
#GPFORUM_POST_SIGNING_KEY=var/keys/post-signing.pem

# Public and private Web Push key-ring directory; private files require mode 0600.
#GPFORUM_PUSH_KEY_DIRECTORY=var/keys/web-push

# Approved Push provider hostnames; *. matches subdomains at a DNS label boundary.
#GPFORUM_PUSH_PROVIDERS=

# Earlier session secrets, comma separated, still accepted while a new one rolls out.
#GPFORUM_SESSION_SECRETS=

# Earlier metrics tokens, comma separated, still accepted while scrapers move to the new one.
#GPFORUM_METRICS_TOKENS=

# Seals two-step sign-in secrets: a long random string; without one, deployed forums offer no two-step sign-in.
#GPFORUM_SECOND_FACTOR_KEY=

# Earlier two-step sign-in keys, comma separated, still opening the secrets they sealed.
#GPFORUM_SECOND_FACTOR_KEYS=

# How often, at most, a signed-in member's session is marked as used.
#GPFORUM_SESSION_TOUCH_INTERVAL_SECONDS=300

# Forum pages one visitor may read per minute; raise it only for a load test from one address.
#GPFORUM_FORUM_READ_RATE_LIMIT=60

# Argon2id memory in MiB (19..256); doctor --calibrate-password measures this host.
#GPFORUM_PASSWORD_MEMORY_MIB=32

# Argon2id iterations (2..10).
#GPFORUM_PASSWORD_ITERATIONS=3

# Mail

# Local MTA address delivered to gpforum mail-in; empty disables replies by email.
#GPFORUM_MAIL_REPLY_ADDRESS=

# DKIM signing domain, matching the sender domain.
#GPFORUM_DKIM_DOMAIN=

# DKIM DNS selector.
#GPFORUM_DKIM_SELECTOR=forum

# Private RSA key file (0600); empty leaves signing to the MTA.
#GPFORUM_DKIM_KEY_FILE=

# The SMTP server, when mail leaves by smtp.
#GPFORUM_SMTP_HOST=

# The SMTP port; 587 is the submission port.
#GPFORUM_SMTP_PORT=587

# The SMTP login, when the server asks for one.
#GPFORUM_SMTP_USERNAME=

# The SMTP password.
#GPFORUM_SMTP_PASSWORD=

# TLS to the SMTP server: starttls, implicit or off; it follows the port, starttls on 587 and implicit on 465.
#GPFORUM_SMTP_TLS=starttls

# Database

# Administrative PostgreSQL connection for API-role provisioning; keep it outside the web service environment.
#GPFORUM_ADMIN_DATABASE_DSN=

# Administrative PostgreSQL role; set it only in the separate operator environment.
#GPFORUM_ADMIN_DATABASE_USER=

# Administrative role password; keep it in the administrator environment or pgpass.
#GPFORUM_ADMIN_DATABASE_PASSWORD=

# Milliseconds a query may run before PostgreSQL cancels it; 0 means no limit.
#GPFORUM_DATABASE_STATEMENT_TIMEOUT_MS=15000

# PostgreSQL memory profile: shared host or dedicated server.
#GPFORUM_POSTGRES_PROFILE=shared

# Refuse nonconforming PostgreSQL connections when explicitly enabled.
#GPFORUM_POSTGRES_STRICT=off

# Database location; declare managed services explicitly.
#GPFORUM_POSTGRES_TOPOLOGY=auto

# Database host or container RAM in MiB; 0 detects only for declared local servers.
#GPFORUM_POSTGRES_MEMORY_MB=0

# RAM reserved for OS, GPForum and other services; 0 reserves half on shared hosts.
#GPFORUM_POSTGRES_RESERVE_MB=0

# Database CPU cores; 0 detects only for declared local servers.
#GPFORUM_POSTGRES_CPU_COUNT=0

# Database storage class; unknown uses conservative planner costs.
#GPFORUM_POSTGRES_STORAGE=unknown

# Milliseconds a transaction may sit idle before PostgreSQL ends it; 0 means no limit.
#GPFORUM_DATABASE_IDLE_IN_TRANSACTION_TIMEOUT_MS=10000

# Milliseconds a statement waits for a lock; 0 means no limit.
#GPFORUM_DATABASE_LOCK_TIMEOUT_MS=3000

# Search

# Milliseconds a search may run, at most the database's limit; 0 uses that limit.
#GPFORUM_SEARCH_STATEMENT_TIMEOUT_MS=2000

# How many of the newest matches a search ranks.
#GPFORUM_SEARCH_CANDIDATE_LIMIT=1000

# Local Sentence Transformers model directory; empty disables semantic search.
#GPFORUM_SEARCH_EMBEDDING_MODEL_PATH=

# Embedding model and preprocessing identity; change when weights change.
#GPFORUM_SEARCH_EMBEDDING_MODEL_KEY=multilingual-minilm-l12-v2

# Python executable with Sentence Transformers installed.
#GPFORUM_SEARCH_EMBEDDING_PYTHON=python3

# Maximum seconds for local embedding inference, including model startup.
#GPFORUM_SEARCH_EMBEDDING_TIMEOUT_SECONDS=5

# Processes

# Web processes; auto runs as many as the CPUs carry.
#GPFORUM_WEB_PROCESSES=auto

# Where Hypnotoad listens, comma separated; the default Unix socket is var/run/gpforum.sock under the code directory.
#GPFORUM_RUNTIME_LISTEN=http+unix://var%2Frun%2Fgpforum.sock

# Hypnotoad's pid file; a relative path starts at the runtime directory systemd makes, or the code directory.
#GPFORUM_RUNTIME_PID_FILE=hypnotoad.pid

# configured runs the web processes as set; cap-to-cpu holds them to what the CPUs carry.
#GPFORUM_RUNTIME_WORKER_POLICY=cap-to-cpu

# Web processes per CPU that auto and cap-to-cpu allow.
#GPFORUM_RUNTIME_MAX_WEB_PER_CPU=2

# Connections the kernel queues before the web server accepts them.
#GPFORUM_RUNTIME_BACKLOG=256

# Connections each web process serves at once.
#GPFORUM_RUNTIME_CLIENTS=250

# Requests one keep-alive connection serves before it is closed.
#GPFORUM_RUNTIME_REQUESTS=1000

# Seconds an idle keep-alive connection stays open.
#GPFORUM_RUNTIME_KEEP_ALIVE_TIMEOUT=5

# Seconds a connection may stay silent before it is closed.
#GPFORUM_RUNTIME_INACTIVITY_TIMEOUT=30

# Seconds a stopping web process has to finish its requests.
#GPFORUM_RUNTIME_GRACEFUL_TIMEOUT=20

# Seconds between a web process's heartbeats.
#GPFORUM_RUNTIME_HEARTBEAT_INTERVAL=5

# Seconds without a heartbeat before a web process is replaced.
#GPFORUM_RUNTIME_HEARTBEAT_TIMEOUT=5

# Seconds a zero-downtime upgrade waits for the new processes.
#GPFORUM_RUNTIME_UPGRADE_TIMEOUT=60

# Extra web processes started ahead of need during a graceful restart.
#GPFORUM_RUNTIME_SPARE_PROCESSES=1

# A reverse proxy is in front (on or off); on believes its X-Forwarded-For.
#GPFORUM_RUNTIME_PROXY=on

# The proxies whose X-Forwarded-For is believed, comma separated; the shipped proxies run on this host.
#GPFORUM_RUNTIME_TRUSTED_PROXIES=127.0.0.1,::1

# Render the main pages once before the workers fork, so their first requests are as fast as the rest (on or off).
#GPFORUM_WARMUP_ENABLED=on

# Operating system

# SO_REUSEPORT on the listen socket: auto, on or off.
#GPFORUM_OS_REUSEPORT=auto

# The worker count below which the host preflight warns.
#GPFORUM_OS_MIN_RECOMMENDED_WORKERS=2

# The open-file limit the host preflight expects.
#GPFORUM_OS_MAX_OPEN_FILE_DESCRIPTORS=65536

# Cache

# Entries each web process keeps in its own cache; auto sizes them from the host's memory.
#GPFORUM_LOCAL_CACHE_MAX_ENTRIES=auto

# Seconds a cached category list is kept.
#GPFORUM_CATEGORY_CACHE_TTL_SECONDS=60

# A GlifiStore shared cache; empty keeps each process to its own cache, which suits one host.
#GPFORUM_GLIFISTORE_URL=

# Live updates

# Internal: live updates through PostgreSQL LISTEN; leave it on.
#GPFORUM_REALTIME_LISTENER_ENABLED=on

# Seconds between checks for live-update notifications.
#GPFORUM_REALTIME_LISTENER_POLL_INTERVAL_SECONDS=1

# Seconds before the live-update listener reconnects.
#GPFORUM_REALTIME_LISTENER_RECONNECT_BACKOFF_SECONDS=5

# Seconds between live-update heartbeats.
#GPFORUM_REALTIME_LISTENER_HEARTBEAT_INTERVAL_SECONDS=30

# Background jobs

# Also run background jobs through Minion (on or off); the outbox worker needs no Minion.
#GPFORUM_MINION_ENABLED=off

# Minion's PostgreSQL URL, required while Minion is on.
#GPFORUM_MINION_PG_URL=

# Days the event log is kept before its monthly partitions are listed as due to detach.
#GPFORUM_EVENT_RETENTION_DAYS=365

# Antivirus

# The clamd socket; empty uses the one the system's package installs.
#GPFORUM_ANTIVIRUS_SOCKET=

# The scanner run on each upload when the antivirus is command.
#GPFORUM_ANTIVIRUS_COMMAND=

# Seconds a scan may take.
#GPFORUM_ANTIVIRUS_TIMEOUT_SECONDS=30
