<header class="site-header<%= session('user_id') ? ' site-header--member' : q{} %>">
  <div class="site-header__inner">
    <a class="brand" href="<%= ui_path('home') %>">
      <svg class="brand__mark" viewBox="16 16 96 96" aria-hidden="true" focusable="false">
        <g fill="none" stroke="currentColor" stroke-width="9" stroke-linecap="round">
          <path d="M100.252 47.095A40 40 0 0 1 47.095 100.252"/>
          <path d="M27.748 80.905A40 40 0 0 1 80.905 27.748"/>
        </g>
        <circle class="brand__node" cx="92.284" cy="35.716" r="5"/>
      </svg>
      <span class="brand__name"><%= t('app.name') %></span>
    </a>
    % if (stash('forum_layout')) {
      <form class="header-search" method="get" action="<%= ui_path('forum_search') %>" role="search">
        <%= ui_icon('search') %>
        <label class="visually-hidden" for="header-search-query"><%= t('search.query') %></label>
        <input id="header-search-query" type="search" name="q" placeholder="<%= t('search.query') %>">
        <button type="submit"><%= ui_icon('search') %><%= t('nav.search') %></button>
      </form>
    % }
    <%= include 'components/primary_nav' %>
    <%= include 'components/identity_nav' %>
  </div>
</header>
