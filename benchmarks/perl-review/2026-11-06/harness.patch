+
+# Sequential health checks can keep reaching the same few idle TCP workers.
+# Issue a small concurrent burst, then require the same per-PID telemetry as
+# before. These requests and connections finish before measured cells begin.
+# Dependencies load only when an actual application server is being started.
+sub _probe_workers( $self, $until ) {
+    require Mojo::Promise;
+    require Mojo::UserAgent;
+    my $timeout = min( 1, $until - monotonic() );
+    return undef if $timeout <= 0;
+    my $ua = Mojo::UserAgent->new(
+        max_connections => $self->{workers} * 2,
+        max_redirects   => 0,
+        request_timeout => $timeout,
+    );
+    my @requests = map {
+        $ua->get_p( $self->{base} . '/health/live', { Connection => 'close' } )
+          ->catch( sub { return undef; } )
+    } 1 .. $self->{workers} * 2;
+    Mojo::Promise->all(@requests)->wait;
     return undef;
