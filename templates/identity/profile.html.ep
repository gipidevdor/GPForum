% layout 'default';
% title $profile->{user}{display_name} . ' - ' . t('app.name');

<section aria-labelledby="profile-heading">
  % my $user = $profile->{user};
  % my $counts = $profile->{counts} || {};
  % my $is_own = ($user->{user_id} // q{}) eq (session('user_id') // q{});
  <div class="profile">
    <%= include 'components/avatar', user_id => $user->{user_id}, avatar_id => $user->{avatar_id}, initial => $user->{initial}, tint => $user->{tint}, size => 'large' %>
    <%= include 'components/page_header',
      heading_id => 'profile-heading',
      component_title => $user->{display_name},
      description => $user->{profile_label} %>
  </div>
  <p class="ui-meta">
    <span class="ui-badge"><%= $profile->{trust}{badge} || t('profile.new_contributor') %></span>
    % if ($user->{created_at}) {
      <span><%= t('profile.joined') %> <%= include 'components/timestamp', at => $user->{created_at} %></span>
    % }
  </p>
  % if (length($user->{bio} // q{})) {
    <div class="profile__bio" aria-label="<%= t('profile.about') %>">
      % for my $paragraph (grep { length } split /\n{2,}/, $user->{bio}) {
        <p><%= $paragraph %></p>
      % }
    </div>
  % }
  <dl class="ui-stats" aria-label="<%= t('profile.contributor_summary') %>">
    <div>
      <dt><%= t('profile.public_contributions') %></dt>
      <dd><%= $counts->{total_public} // 0 %></dd>
    </div>
    <div>
      <dt><%= t('profile.public_threads') %></dt>
      <dd><%= $counts->{public_threads} // 0 %></dd>
    </div>
    <div>
      <dt><%= t('profile.public_replies') %></dt>
      <dd><%= $counts->{public_replies} // 0 %></dd>
    </div>
    <div>
      <dt><%= t('profile.reputation_score') %></dt>
      <dd><%= $profile->{trust}{score} %></dd>
    </div>
    <div>
      <dt><%= t('admin.trust_level') %></dt>
      <dd><%= $profile->{trust}{trust_level} %></dd>
    </div>
  </dl>
  % if (session('user_id') && !$is_own) {
    %# ADR 0130: the reader's own ignore or block, which only they see.
    % my $held = stash('relation') // q{};
    % my $remove_to = ui_path('profile_relation_remove', username => $user->{username});
    % if (length $held) {
      <p class="ui-meta" role="status"><%= t($held eq 'block' ? 'community.relation_blocking_notice' : 'community.relation_ignoring_notice') %></p>
    % }
    <div class="toolbar">
      %# ADR 0139: write to the member, unless the reader blocks them.
      % if ($held ne 'block') {
        <a class="button button--secondary" href="<%= ui_path('message_compose', username => $user->{username}) %>"><%= t('messages.write') %></a>
      % }
      <button type="button" class="button--quiet" popovertarget="profile-report"><%= t('moderation.report_profile') %></button>
      <%= include 'components/sheet', sheet_id => 'profile-report', component_title => t('moderation.report_profile'), sheet_body => begin %>
        <%= include 'forum/_report_form',
          post_to => ui_path('profile_report', username => $user->{username}),
          command_id => $profile->{report_command_id},
          field_id => 'profile-report' %>
      <% end %>
      % if (!length $held) {
        <form method="post" action="<%= ui_path('profile_ignore', username => $user->{username}) %>">
          <%= csrf_field %>
          <button type="submit" class="button--quiet"><%= t('community.relation_ignore') %></button>
        </form>
      % } elsif ($held eq 'ignore') {
        <form method="post" action="<%= $remove_to %>">
          <%= csrf_field %>
          <button type="submit" class="button--quiet"><%= t('community.relation_unignore') %></button>
        </form>
      % }
      % if ($held eq 'block') {
        <form method="post" action="<%= $remove_to %>">
          <%= csrf_field %>
          <button type="submit" class="button--quiet"><%= t('community.relation_unblock') %></button>
        </form>
      % } else {
        <button type="button" class="button--quiet" popovertarget="profile-block"><%= t('community.relation_block') %></button>
        <%= include 'components/sheet', sheet_id => 'profile-block', component_title => t('community.relation_block'), sheet_body => begin %>
          <form method="post" action="<%= ui_path('profile_block', username => $user->{username}) %>">
            <%= csrf_field %>
            <p class="sheet__consequence"><%= t('community.relation_block_consequence') %></p>
            <button type="submit" class="button--danger"><%= t('community.relation_block') %></button>
          </form>
        <% end %>
      % }
    </div>
  % }
  % if (stash('avatar_moderation')) {
    %# ADR 0144: staff remove the picture shown, the one this page showed.
    <div class="toolbar">
      <button type="button" class="button--quiet" popovertarget="profile-avatar-remove"><%= t('avatar.moderate') %></button>
      <%= include 'components/sheet', sheet_id => 'profile-avatar-remove', component_title => t('avatar.moderate'), sheet_body => begin %>
        <form method="post" action="<%= ui_path('moderation_avatar_remove', user_id => $user->{user_id}) %>">
          <%= csrf_field %>
          <input type="hidden" name="avatar_id" value="<%= $user->{avatar_id} %>">
          <input type="hidden" name="return_to" value="<%= ui_path('profile', username => $user->{username}) %>">
          <label for="profile-avatar-reason"><%= t('avatar.moderate_reason') %></label>
          <textarea id="profile-avatar-reason" name="reason" rows="3" maxlength="500"></textarea>
          <p class="sheet__consequence"><%= t('avatar.moderate_consequence') %></p>
          <button type="submit" class="button--danger"><%= t('avatar.moderate') %></button>
        </form>
      <% end %>
    </div>
  % }
</section>

<section aria-labelledby="profile-replies-heading">
  <%= include 'components/section_header',
    heading_id => 'profile-replies-heading',
    component_title => t('profile.recent_public_replies') %>
  % my $replies = $profile->{replies} || { items => [] };
  % if (@{ $replies->{items} }) {
    <ol class="ui-card-list" aria-label="<%= t('profile.recent_public_replies_by_contributor') %>">
      % for my $reply (@{ $replies->{items} }) {
        <li class="ui-card-list__item ui-row">
          <article aria-labelledby="profile-reply-<%= $reply->{post_id} %>-heading">
            <h3 class="ui-row__title" id="profile-reply-<%= $reply->{post_id} %>-heading">
              <a href="<%= url_for('thread', thread_id => $reply->{thread_id})->fragment('post-' . $reply->{post_id}) %>"><%= $reply->{thread_title} || t('profile.discussion_reply') %></a>
            </h3>
            % if ($reply->{created_at}) {
              <p class="ui-meta"><span><%= t('profile.replied') %> <%= include 'components/timestamp', at => $reply->{created_at} %></span></p>
            % }
          </article>
        </li>
      % }
    </ol>
  % } else {
    <%= include 'components/empty_state',
      heading_id => 'profile-replies-empty-heading',
      component_title => t('profile.no_public_replies') %>
  % }
</section>

<section aria-labelledby="profile-threads-heading">
  <%= include 'components/section_header',
    heading_id => 'profile-threads-heading',
    component_title => t('profile.public_discussions') %>
  % if (@{ $profile->{threads}{items} }) {
    <ol class="ui-card-list" aria-label="<%= t('profile.public_discussions_by_contributor') %>">
      % for my $thread (@{ $profile->{threads}{items} }) {
        <li class="ui-card-list__item ui-row">
          <article aria-labelledby="profile-thread-<%= $thread->{thread_id} %>-heading">
            <h3 class="ui-row__title" id="profile-thread-<%= $thread->{thread_id} %>-heading">
              <a href="<%= ui_path('thread', thread_id => $thread->{thread_id}) %>"><%= $thread->{title} %></a>
            </h3>
            % if ($thread->{last_activity_at}) {
              <p class="ui-meta"><span><%= t('forum.last_activity') %> <%= include 'components/timestamp', at => $thread->{last_activity_at} %></span></p>
            % }
          </article>
        </li>
      % }
    </ol>
  % } else {
    <%= include 'components/empty_state',
      heading_id => 'profile-threads-empty-heading',
      component_title => t('profile.no_public_discussions') %>
  % }
  % if ($profile->{threads}{next_cursor}) {
    <%= include 'components/pagination',
      label => t('profile.profile_activity_pagination'),
      items => ui_next_page(
        href => url_for('profile', username => $profile->{user}{username})->query(after => $profile->{threads}{next_cursor}),
        label => t('profile.older_public_discussions'),
      ) %>
  % }
</section>
