msgid "Address"
msgstr "Indirizzo"

#, python-brace-format
msgctxt "admin.address_ban_check_clear"
msgid "No live ban covers {address}."
msgstr "Nessun blocco attivo copre {address}."

#, python-brace-format
msgctxt "admin.address_ban_check_covered"
msgid "{address} is covered by the ban on {range}: {scope}."
msgstr "{address} è coperto dal blocco su {range}: {scope}."

