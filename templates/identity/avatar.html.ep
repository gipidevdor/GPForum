% layout 'default';
% title t('avatar.title') . ' - ' . t('app.name');
%# ADR 0144: the member's picture, the one waiting, the form that uploads a
%# new one and the one that takes it away. Everything works without
%# JavaScript; the upload is an ordinary multipart form.
% my $shown = stash('shown_id');
% my $pending = stash('pending_state') // q{};

<section aria-labelledby="avatar-heading">
  <%= include 'components/page_header',
    heading_id => 'avatar-heading',
    component_title => t('avatar.title'),
    description => t('avatar.intro'),
    actions_label => t('settings.title'),
    actions => ui_actions(
      { href => ui_path('settings'), label => t('settings.title') },
    ) %>

  % if (stash('error')) {
    <%= include 'components/alert', tone => 'error', message => stash('error') %>
  % }
  % if ($pending eq 'checking') {
    <%= include 'components/alert', tone => 'notice', message => t('avatar.pending_checking') %>
  % } elsif ($pending eq 'refused') {
    <%= include 'components/alert', tone => 'warning', message => t('avatar.pending_refused') %>
  % } elsif ($pending eq 'unreadable') {
    <%= include 'components/alert', tone => 'warning', message => t('avatar.pending_unreadable') %>
  % }

  <section class="settings-group" aria-labelledby="avatar-current-heading">
    <h2 id="avatar-current-heading"><%= t('avatar.current') %></h2>
    % if ($shown) {
      <div class="profile">
        <%= include 'components/avatar', user_id => stash('user_id'), avatar_id => $shown, size => 'large' %>
        % if (stash('shown_at')) {
          <p class="ui-meta"><%= t('avatar.shown_since') %> <%= include 'components/timestamp', at => stash('shown_at') %></p>
        % }
      </div>
    % } else {
      <p><%= t('avatar.none') %></p>
    % }
    % if ($shown || length $pending) {
      <form method="post" action="<%= ui_path('settings_avatar_remove') %>">
        <%= csrf_field %>
        <button type="submit" class="button--quiet"><%= t('avatar.remove') %></button>
      </form>
    % }
  </section>

  <section class="settings-group" aria-labelledby="avatar-upload-heading">
    <h2 id="avatar-upload-heading"><%= t($shown ? 'avatar.replace' : 'avatar.upload') %></h2>
    % if (stash('available')) {
      <form method="post" action="<%= ui_path('settings_avatar_upload') %>" enctype="multipart/form-data">
        <%= csrf_field %>
        <label for="avatar-file"><%= t('avatar.file') %></label>
        <input id="avatar-file" name="avatar" type="file" accept="image/png,image/jpeg,image/gif,image/webp" required aria-describedby="avatar-file-hint">
        <p class="ui-meta" id="avatar-file-hint"><%= t('avatar.file_hint', { megabytes => int(stash('maximum_bytes') / (1024 * 1024)), pixels => stash('maximum_side') }) %></p>
        <button type="submit"><%= t('avatar.send') %></button>
      </form>
    % } else {
      <p><%= t('avatar.unavailable') %></p>
    % }
  </section>
</section>
