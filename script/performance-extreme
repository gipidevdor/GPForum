package main;

use v5.40;
use FindBin;
use lib "$FindBin::Bin/lib";
use lib "$FindBin::Bin/../lib";
use GPForum::Performance::Extreme;
use GPForum::Performance::Support qw(redact);

our $VERSION = '0.001';

my $status;
try { $status = GPForum::Performance::Extreme::main(@ARGV); }
catch ($error) {
    warn 'performance-extreme: ' . redact($error) . "\n";
    $status = 1;
};
exit $status;
