+# Cells share authenticated identities, not idle sockets. A socket left unused
+# while another concurrency level runs can expire at the server's keep-alive
+# deadline just as the next cell reuses it. Keep cookies/CSRF/context, and make
+# the next cell open its own connections. Requests within a cell retain normal
+# keep-alive; transport failures are still recorded and never retried here.
+sub reset_connections ($self) {
+    my $cookies = $self->ua->cookie_jar;
+    $self->ua(
+        Mojo::UserAgent->new(
+            cookie_jar      => $cookies,
+            max_redirects   => 0,
+            request_timeout => $TIMEOUT
+        )
+    );
+    return $self;
+}
