+                  if @{ $self->idle };
+                return $self->_connect_p($context)->then(
                     sub ($leased) {
-                        $db = $leased;
-                        my $run = sub { return $work->($db); };
-                        return $stats
-                          ? $stats->in_context( $context, $run )
-                          : $run->();
-                    }
-                )->catch(
-                    sub ($error) {
-                        $failed = 1;
-                        die $error;    ## no critic (ErrorHandling::RequireCarping) -- preserve the promise rejection
-                    }
-                )->finally(
-                    sub {
-                        return if !$db;
-                        if ( $failed || $generation != $self->generation ) {
-                            @{ $self->connections } =
-                              grep { $_ != $db } @{ $self->connections };
-                        }
-                        else { push @{ $self->idle }, $db; }
-                        undef $db;
-                        return;
+                        return $self->_run_leased_p( $leased, $work, $stats,
+                            $context, $generation );
                     }
                 );
             };
@@ -140,6 +118,39 @@
     );
 }
 
+sub _run_leased_p ( $self, $db, $work, $stats, $context, $generation ) {
+
+    # One completion owns lease cleanup on success, rejection and synchronous
+    # failure. Reusing an idle handle needs no intermediate promise chain.
+    my $result = Mojo::Promise->new;
+    my $finish = sub ( $failed, @values ) {
+        if ( $failed || $generation != $self->generation ) {
+            @{ $self->connections } =
+              grep { $_ != $db } @{ $self->connections };
+        }
+        else { push @{ $self->idle }, $db; }
+        my $status = $failed ? 'reject' : 'resolve';
+        $result->$status(@values);
+        return;
+    };
+    my ( $running, $error );
+    try {
+        my $run = sub { return $work->($db); };
+        $running = Mojo::Promise->resolve(
+            $stats ? $stats->in_context( $context, $run ) : $run->() );
+    }
+    catch ($caught) { $error = $caught; };
+    if ( defined $error ) {
+        $finish->( 1, $error );
+        return $result;
+    }
+    $running->then(
+        sub (@values) { $finish->( 0, @values ); return; },
+        sub (@errors) { $finish->( 1, @errors ); return; }
+    );
+    return $result;
+}
+
 1;
 
 __END__
