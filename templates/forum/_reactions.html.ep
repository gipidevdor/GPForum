%# The reactions on a post (ADR 0145): four, each a small form for a
%# reader who may react (pressed when they gave it) or a count for one who
%# may not; a reaction nobody gave shows only to a reader who may give it.
%# Takes "post". A reaction's texts are the same for every post of the page,
%# so each is made the first time a post needs it and kept on the stash for
%# the rest: every post's include was four lookups and four interpolations.
% my $post = stash('post');
% my @reactions = @{ $post->{reactions} || [] };
% my %label_key = ( heart => 'forum.reaction_heart', laugh => 'forum.reaction_laugh', celebrate => 'forum.reaction_celebrate', think => 'forum.reaction_think' );
% my $texts = $c->stash->{'gp.reaction_texts'} //= {};
% my %emoji = ( heart => "\x{2764}\x{FE0F}", laugh => "\x{1F604}", celebrate => "\x{1F389}", think => "\x{1F914}" );
% my @shown = grep { $post->{can_react} || $_->{count} } @reactions;
% if (@shown) {
  <div class="post__reactions" role="group" aria-label="<%= t('forum.reactions') %>">
    % for my $reaction (@shown) {
    %   my $name = $reaction->{reaction};
    %   my $text = $texts->{$name} //= { label => t($label_key{$name}) };
      % if ($post->{can_react}) {
      %   my $path = ui_path($reaction->{reacted} ? 'post_unreact' : 'post_react', post_id => $post->{post_id}, reaction => $name);
      %   my $aria = $reaction->{reacted}
      %     ? $text->{remove} //= t('forum.remove_reaction', { reaction => $text->{label} })
      %     : $text->{react} //= t('forum.react_with', { reaction => $text->{label} });
        <form method="post" action="<%= $path %>" hx-post="<%= $path %>">
          <%= csrf_field %>
          <input type="hidden" name="command_id" value="<%= $reaction->{command_id} || q{} %>">
          <button type="submit" class="post__reaction" aria-pressed="<%= $reaction->{reacted} ? 'true' : 'false' %>" aria-label="<%= $aria %>"><span aria-hidden="true"><%= $emoji{$name} %></span><span class="post__reaction-count"><%= $reaction->{count} %></span></button>
        </form>
      % } else {
        <span class="post__reaction post__reaction--static"><span aria-hidden="true"><%= $emoji{$name} %></span><span class="visually-hidden"><%= $text->{label} %></span><span class="post__reaction-count"><%= $reaction->{count} %></span></span>
      % }
    % }
  </div>
% }
