# Candidate: 16 available CPU cores, 32 GiB RAM, local SSD/NVMe PostgreSQL.
# Merge into the existing service environment; this is not a complete config.
# See docs/ops/throughput-tuning.md. No speedup has been measured for this profile.
GPFORUM_WEB_PROCESSES=16
GPFORUM_RUNTIME_WORKER_POLICY=cap-to-cpu
GPFORUM_RUNTIME_MAX_WEB_PER_CPU=2
GPFORUM_RUNTIME_CLIENTS=32
GPFORUM_RUNTIME_BACKLOG=1024
GPFORUM_RUNTIME_SPARE_PROCESSES=4
GPFORUM_RUNTIME_REQUESTS=1000
GPFORUM_RUNTIME_KEEP_ALIVE_TIMEOUT=5

# Declares an assessment policy; does not configure PostgreSQL.
# Reserve 16 GiB for the OS, application workers, caches and other services.
GPFORUM_POSTGRES_PROFILE=shared
GPFORUM_POSTGRES_TOPOLOGY=local
GPFORUM_POSTGRES_MEMORY_MB=32768
GPFORUM_POSTGRES_RESERVE_MB=16384
GPFORUM_POSTGRES_CPU_COUNT=16
GPFORUM_POSTGRES_STORAGE=nvme
GPFORUM_POSTGRES_STRICT=0
