# Formulae installed by `brew bundle` in .github/workflows/platform-macos.yml.
#
# This CI profile exercises Homebrew Perl. Other supported runtimes can be
# selected with GPFORUM_PERL or PATH. cpanminus bootstraps
# cpm and Carton for it. postgresql@18 is keg-only: its client bins sit under
# $(brew --prefix)/opt/postgresql@18/bin, where
# script/gpforum-homebrew-env --check looks for them.
brew "perl"
brew "cpanminus"
brew "postgresql@18"
brew "pgvector"
