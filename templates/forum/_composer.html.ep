%# Where a reply is written. Sent by the page's script when it has one
%# (hx-post), the reply comes back as the post to append to the list; the
%# composer itself comes back out of band with a fresh command id, so the next
%# reply is a new command. Without the script the form posts and the page
%# reloads at the new post.
%#
%# Reads the page's "thread" and "reply_command_id"; "swap_oob" marks this
%# copy as the one that replaces the page's.
% my $thread_id = $thread->{thread_id};
% my $draft = stash('composer_draft') || {};
% my $standalone = stash('composer_standalone');
<section class="composer" id="reply" aria-labelledby="reply-heading"<%== stash('swap_oob') ? ' hx-swap-oob="true"' : q{} %>>
  <h2 id="reply-heading"><%= t('forum.reply') %></h2>
  <form data-composer data-suggest-url="<%= ui_path('search_autocomplete') %>" data-thread-base="<%= ui_path('thread', thread_id => 'THREAD_ID') %>" method="post" action="<%= ui_path('reply_create', thread_id => $thread_id) %>"<% if (!$standalone) { %> hx-post="<%= ui_path('reply_create', thread_id => $thread_id) %>" hx-target="#posts" hx-swap="beforeend"<% } %>>
    <%= csrf_field %>
    <input type="hidden" name="command_id" value="<%= $draft->{command_id} || $reply_command_id || q{} %>">
    % if ($draft->{reply_to}) {
      <input type="hidden" name="reply_to_post_id" value="<%= $draft->{reply_to}{post_id} %>">
      <p class="composer__reply-to">
        <span><%= t('forum.replying_to', { position => '#' . $draft->{reply_to}{position}, author => '@' . ($draft->{reply_to}{author_username} // t('forum.unknown_author')) }) %></span>
        <a href="<%= ui_path('thread', thread_id => $thread_id) %>#reply-body"><%= t('forum.cancel_reply_to') %></a>
      </p>
    % }
    <label class="visually-hidden" for="reply-body"><%= t('forum.reply_body') %></label>
    <textarea id="reply-body" name="body_source" rows="8" required><%= $draft->{body_source} // q{} %></textarea>
    <%= include 'forum/_draft_tools', composer_kind => 'reply', composer_thread_id => $thread_id %>
    <button type="submit"><%= t('forum.post_reply') %></button>
  </form>
  <%= include 'forum/_preview' %>
</section>
