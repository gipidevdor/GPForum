diff --git a/lib/GPForum/Infrastructure/AsyncGate.pm b/lib/GPForum/Infrastructure/AsyncGate.pm
--- a/lib/GPForum/Infrastructure/AsyncGate.pm
+++ b/lib/GPForum/Infrastructure/AsyncGate.pm
@@ -12,7 +12,7 @@
 
 our $VERSION = '0.001';
 has concurrency   => 2;
-has max_pending   => 16;
+has max_pending   => 256;
 has queue_timeout => 15;
 has active        => 0;
 has pending       => sub { return []; };
@@ -58,19 +58,33 @@
         my $job = shift @{ $self->pending };
         if ( defined $job->{timer} ) { Mojo::IOLoop->remove( $job->{timer} ); }
         $self->active( $self->active + 1 );
-        my $running =
-          Mojo::Promise->resolve->then( sub { return $job->{work}->(); } );
-        $running->then(
-            sub (@values) { $job->{promise}->resolve(@values); return; },
-            sub (@errors) { $job->{promise}->reject(@errors);  return; }
-        )->finally(
-            sub {
-                $self->active( $self->active - 1 );
-                $self->_pump;
-                return;
-            }
-        );
+        Mojo::IOLoop->next_tick( sub { $self->_start($job); return; } );
     }
+    return;
+}
+
+sub _start ( $self, $job ) {
+    my ( $running, $error );
+    try { $running = Mojo::Promise->resolve( $job->{work}->() ); }
+    catch ($caught) { $error = $caught; };
+    if ( defined $error ) {
+        $self->_complete( $job, 'reject', $error );
+        return;
+    }
+    $running->then(
+        sub (@values) { $self->_complete( $job, 'resolve', @values ); return; },
+        sub (@errors) { $self->_complete( $job, 'reject',  @errors ); return; }
+    );
+    return;
+}
+
+sub _complete ( $self, $job, $status, @values ) {
+
+    # Consumers may immediately submit another query. Release capacity before
+    # their continuation runs, without a deferred finally chain retaining it.
+    $self->active( $self->active - 1 );
+    $self->_pump;
+    $job->{promise}->$status(@values);
     return;
 }
 
diff --git a/lib/GPForum/Infrastructure/AsyncQuery.pm b/lib/GPForum/Infrastructure/AsyncQuery.pm
--- a/lib/GPForum/Infrastructure/AsyncQuery.pm
+++ b/lib/GPForum/Infrastructure/AsyncQuery.pm
