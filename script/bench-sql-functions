our $VERSION = '0.001';

# ADR 0126: what an operation costs on the path DBIx::Class builds and on
# the PostgreSQL function that replaces it, on the same seeded database. Per
# operation and path: the Perl CPU, the share of it spent in DBIx::Class
# (SQL::Abstract building the SQL, resultsets, storage, row inflation,
# accessors) against the time spent waiting on DBI, the wall time's median
# and 95th percentile with the database on this host and through a proxy
# that delays each direction (a database on another host), and the
# statements and round trips. A maintainer's tool: it makes a database of
# its own, seeds it as t/integration/postgres-query-plan-depth.t does, and
# drops it.
const my %DEFAULT => (
    'before-search-version'    => 2,
    'delay-ms'                 => 0.5,
    'implementation-reference' => 'search-v6-custom-plans',
    'read-iterations'          => 200,
    'warmup'                   => 15,
    'write-iterations'         => 100,
);
const my $THREAD_POSTS      => 3_000;
const my $SEEDED_POSTS      => 8;
const my $CATEGORY_THREADS  => 1_500;
const my $NOTIFICATIONS     => 30;
const my $HALFWAY           => 1_500;
const my $MILLISECONDS      => 1_000;
const my $CLOCKS_PER_SECOND => 1_000_000;
const my $PERCENTILE        => 0.95;
const my $SELECT_ONE_RUNS   => 2_000;
const my $LISTEN_QUEUE      => 16;
const my $CHUNK             => 65_536;
const my @PATHS             => qw(dbic function);
const my @MODES             => qw(direct proxy);
const my @PAIRED_PATHS      => qw(before after);
const my @PAIRED_OPERATIONS => qw(search_ranked search_autocomplete post_edit);
const my $ORIGINAL_SEARCH_VERSION => 2;
const my %BASELINE_COMMIT => (
    2 => '2cb9945',
    4 => '200f902',
);
const my @ROUND_TRIPS => qw(
  begin_work commit rollback pg_savepoint pg_release pg_rollback_to
);

exit main(@ARGV);

sub main (@arguments) {
    my %option = %DEFAULT;
    GetOptionsFromArray(
        \@arguments,               \%option,
        'delay-ms=f',              'json',
        'read-iterations=i',       'warmup=i',
        'write-iterations=i',      'paired-functions|paired',
        'before-search-version=i', 'implementation-reference=s',
        'help'
    ) or return _usage(2);
    return _usage(0) if $option{help};
    return _usage(2) if @arguments || !_valid_options( \%option );

    my $admin_dsn = $ENV{GPFORUM_DATABASE_DSN}
      // croak 'set GPFORUM_DATABASE_DSN to a database the user may CREATE in';
    my $name  = "gpforum_bench_sqlfn_$PROCESS_ID";
    my $admin = _connect($admin_dsn);
    my $proxy;
    my $report;
    $admin->do("CREATE DATABASE $name");
    try {
        ( my $dsn = $admin_dsn ) =~ s/dbname=[^;]+/dbname=$name/msx;
        _seed($dsn);
        $proxy = _proxy( $dsn, $option{'delay-ms'} / $MILLISECONDS );
        $report =
          $option{'paired-functions'}
          ? _measure_paired( $dsn, $proxy, \%option )
          : _measure( $dsn, $proxy, \%option );
        $report->{benchmark} = {
            database_name    => $name,
            generated_at     => strftime( '%Y-%m-%dT%H:%M:%SZ', gmtime ),
            perl_version     => "$PERL_VERSION",
            architecture     => $Config{archname},
            postgres_version =>
              scalar $admin->selectrow_array('SHOW server_version'),
            read_iterations  => $option{'read-iterations'},
            write_iterations => $option{'write-iterations'},
            warmup           => $option{warmup},
            scope            =>
'service operations; excludes HTTP dispatch and template rendering',
            workload =>
'small performance seed plus 3000 posts with bodies, 1500 indexed threads and 30 notifications',
        };
    }
    catch ($error) {
        _stop($proxy);
        $admin->do("DROP DATABASE IF EXISTS $name WITH (FORCE)");
        croak $error;
    };
    _stop($proxy);
    $admin->do("DROP DATABASE IF EXISTS $name WITH (FORCE)");
    $admin->disconnect;

    print $option{json} ? encode_json($report) . "\n" : _text($report)
      or croak 'cannot write the report';

    return 0;
}

sub _valid_options ($option) {
    return
         $option->{'read-iterations'} >= 1
      && $option->{'write-iterations'} >= 1
      && $option->{warmup} >= 0
      && $option->{'delay-ms'} >= 0
      && exists $BASELINE_COMMIT{ $option->{'before-search-version'} }
      && $option->{'implementation-reference'} ne q{};
}

sub _usage ($status) {
    print 'Usage: script/bench-sql-functions [--read-iterations N]'
      . " [--write-iterations N] [--warmup N] [--delay-ms MS] [--json]\n"
      . "       Add --paired-functions for alternating stored-function before/after pairs.\n"
      . "       --before-search-version 2|4 selects the retained baseline (default: 2).\n"
      . "       --implementation-reference REF identifies the measured implementation.\n"
      or croak 'cannot write the usage';

    return $status;
}

sub _connect ($dsn) {
    return DBI->connect(
        $dsn,
        $ENV{GPFORUM_DATABASE_USER},
        $ENV{GPFORUM_DATABASE_PASSWORD},
        { AutoCommit => 1, PrintError => 0, RaiseError => 1 },
    );
}

# The plan tests' seed, and what t/integration/postgres-query-plan-depth.t
# adds -- 3,000 posts in the first thread and 1,500 threads in the first
# category -- the posts with bodies, so a page renders full posts.
sub _seed ($dsn) {
    local $ENV{GPFORUM_DATABASE_DSN} = $dsn;
    my $quiet = sub ($code) {
        my $output = q{};
        open my $sink, '>', \$output or croak "capture: $OS_ERROR";
        my $status;
        {
            local *STDOUT = $sink;
            $status = $code->();
        }
        close $sink or croak "capture: $OS_ERROR";
        return $status;
    };
    croak 'migrations failed'
      if $quiet->( sub { GPForum::Command::Migrate->new->run('--apply') } );
    croak 'seed failed'
      if $quiet->(
        sub {
            GPForum::Command::PerformanceSeed->new->run( '--profile', 'small' );
        }
      );

    my $dbh = _connect($dsn);
    my ( $thread, $category, $author ) = (
        seed_id( thread   => 1 ),
        seed_id( category => 1 ),
        seed_id( user     => 2 ),
    );
    $dbh->do(
        q{INSERT INTO posts (post_id, thread_id, author_user_id, position)}
          . q{ SELECT gen_random_uuid(), ?, ?, n}
          . q{ FROM generate_series(?::bigint, ?::bigint) AS n},
        undef,
        $thread,
        $author,
        $SEEDED_POSTS + 1,
        $SEEDED_POSTS + $THREAD_POSTS
    );
    $dbh->do(
        q{WITH b AS (INSERT INTO post_bodies (body_id, post_id, body_format,}
          . q{ body_source, body_rendered_safe, source_hash)}
          . q{ SELECT gen_random_uuid(), p.post_id, 'markdown',}
          . q{ 'Reply number ' || p.position || ' with a little text.',}
          . q{ '<p>Reply number ' || p.position || ' with a little text.</p>',}
          . q{ md5(p.post_id::text) FROM posts p WHERE p.thread_id = ?}
          . q{ AND p.current_body_id IS NULL RETURNING body_id, post_id)}
          . q{ UPDATE posts p SET current_body_id = b.body_id FROM b}
          . q{ WHERE b.post_id = p.post_id},
        undef, $thread
    );
    $dbh->do(
        q{INSERT INTO threads (thread_id, category_id, author_user_id, title,}
          . q{ slug, last_activity_at) SELECT gen_random_uuid(), ?, ?,}
          . q{ 'Depth ' || n, 'depth-' || n, timestamptz '2026-01-01'}
          . q{ + n * interval '1 minute' FROM generate_series(1, ?) AS n},
        undef, $category, $author, $CATEGORY_THREADS
    );
    my $index_schema = _schema($dsn);
    my $indexer =
      GPForum::Service::Search::Indexer->new( schema => $index_schema );
    for my $id (
        @{
            $dbh->selectcol_arrayref(
q{SELECT thread_id FROM threads WHERE category_id = ? AND slug LIKE 'depth-%'},
                undef, $category
            )
        }
      )
    {
        $indexer->index_thread($id);
    }
    $index_schema->storage->disconnect;
    $dbh->do('ANALYZE');
    $dbh->disconnect;

    return;
}

# A TCP proxy that holds each chunk for the delay before passing it on, in
# both directions: a database on another host, as far as round trips go.
# One process listens; one per connection forwards.
sub _proxy ( $dsn, $delay ) {
    my ($host)   = $dsn =~ /host=([^;]+)/msx;
    my ($port)   = $dsn =~ /port=(\d+)/msx;
    my $listener = IO::Socket::INET->new(
        Listen    => $LISTEN_QUEUE,
        LocalAddr => '127.0.0.1',
        LocalPort => 0,
        ReuseAddr => 1,
    ) or croak "proxy listen: $OS_ERROR";
    my $pid = fork // croak "fork: $OS_ERROR";
    if ( $pid == 0 ) {
        local $SIG{CHLD} = 'IGNORE';
        while ( my $client = $listener->accept ) {
            my $child = fork // croak "fork: $OS_ERROR";
            if ( $child == 0 ) {
                _forward( $client, $host // '127.0.0.1', $port, $delay );
                _exit(0);
            }
            close $client or croak "close: $OS_ERROR";
        }
        _exit(0);
    }
    my $proxy_port = $listener->sockport;
    close $listener or croak "close: $OS_ERROR";
    ( my $through = $dsn ) =~ s/port=\d+/port=$proxy_port/msx;
    $through =~ s/host=[^;]+/host=127.0.0.1/msx;

    return { dsn => $through, pid => $pid };
}

sub _forward ( $client, $host, $port, $delay ) {
    my $server = IO::Socket::INET->new( PeerAddr => $host, PeerPort => $port )
      or _exit(1);
    my %peer   = ( $client => $server, $server => $client );
    my $select = IO::Select->new( $client, $server );
    while ( my @ready = $select->can_read ) {
        for my $from (@ready) {
            my $chunk;
            my $read = sysread $from, $chunk, $CHUNK;
            return if !$read;
            sleep $delay;
            my $to      = $peer{$from};
            my $written = 0;
            while ( $written < length $chunk ) {
                my $sent = syswrite $to, $chunk, length($chunk) - $written,
                  $written;
                return if !$sent;
                $written += $sent;
            }
        }
    }

    return;
}

sub _stop ($proxy) {
    return if !$proxy;

    kill 'TERM', $proxy->{pid};
    waitpid $proxy->{pid}, 0;

    return;
}

sub _schema ($dsn) {
    local $ENV{GPFORUM_DATABASE_DSN} = $dsn;

    return GPForum::Schema->connect_from_config(
        GPForum::Config->from_environment );
}

# Every operation on each path, at the database and through the proxy,
# then the profile of each at the database.
sub _measure ( $dsn, $proxy, $option ) {
    my %report = (
        delay_ms      => $option->{'delay-ms'},
        round_trip_ms => {
            direct => _select_one($dsn),
            proxy  => _select_one( $proxy->{dsn} ),
        },
    );
    for my $mode (@MODES) {
        my $schema = _schema( $mode eq 'direct' ? $dsn : $proxy->{dsn} );
        my $counts = _counted( $schema->storage->dbh );
        for my $path (@PATHS) {
            my $ops = _operations( $schema, $path );
            for my $op ( sort keys %{$ops} ) {
                $report{operations}{$op}{$path}{$mode} =
                  _timed( $ops->{$op}, $counts, $option );
            }
        }
        $schema->storage->disconnect;
    }

    my $schema = _schema($dsn);
    for my $path (@PATHS) {
        my $ops = _operations( $schema, $path );
        for my $op ( sort keys %{$ops} ) {
            $report{operations}{$op}{$path}{profile} =
              _profiled( $ops->{$op}, $option );
        }
    }
    $schema->storage->disconnect;

    return \%report;
}

sub _select_one ($dsn) {
    my $dbh = _connect($dsn);
    my $one = $dbh->prepare('SELECT 1');
    my @runs;
    for ( 1 .. $SELECT_ONE_RUNS ) {
        my $started = time;
        $one->execute;
        $one->fetchall_arrayref;
        push @runs, time - $started;
    }
    $dbh->disconnect;

    return _ms( _median(@runs) );
}

# Both sides retain the stored-function layer, on one handle and dataset with
# alternating order. Version 2 includes the original post preflight; version 4
# isolates the search change with the same combined context on both sides.
sub _measure_paired ( $dsn, $proxy, $option ) {
    my $catalogue = GPForum::Infrastructure::SqlFunctionCatalogue->new;
    my %entries =
      map { $_ => { %{ $catalogue->entries->{$_} } } } @{ $catalogue->names };
    for my $name (qw(search_ranked search_autocomplete)) {
        $entries{$name}{version} = $option->{'before-search-version'};
    }
    my $before = GPForum::Infrastructure::SqlFunctionCatalogue->new(
        entries => \%entries );
    my %report = (
        delay_ms      => $option->{'delay-ms'},
        round_trip_ms => {
            direct => _select_one($dsn),
            proxy  => _select_one( $proxy->{dsn} )
        },
        comparison => {
            mode            => 'paired-functions',
            baseline_commit =>
              $BASELINE_COMMIT{ $option->{'before-search-version'} },
            implementation_reference => $option->{'implementation-reference'},
            order  => 'before/after on odd pairs; after/before on even pairs',
            before => {
                search_ranked => $before->function('search_ranked')->{version},
                search_autocomplete =>
                  $before->function('search_autocomplete')->{version},
                post_preflight => $option->{'before-search-version'} ==
                  $ORIGINAL_SEARCH_VERSION
                ? 'forum_find_post_v2 + forum_thread_page_head_v2'
                : 'forum_post_context_v2'
            },
            after => {
                search_ranked =>
                  $catalogue->function('search_ranked')->{version},
                search_autocomplete =>
                  $catalogue->function('search_autocomplete')->{version},
                post_preflight => 'forum_post_context_v2'
            },
            write_function =>
              $catalogue->function('forum_write_command')->{function},
        },
    );
    for my $mode (@MODES) {
        my $schema      = _schema( $mode eq 'direct' ? $dsn : $proxy->{dsn} );
        my $counts      = _counted( $schema->storage->dbh );
        my $edit_number = 0;
        my %operations;
        for my $path (@PAIRED_PATHS) {
            my $functions = GPForum::Infrastructure::SqlFunction->new(
                schema    => $schema,
                catalogue => $path eq 'before' ? $before : $catalogue
            );
            $operations{$path} = _operations( $schema, 'function',
                { functions => $functions, edit_counter => \$edit_number } );
        }
        if ( $option->{'before-search-version'} == $ORIGINAL_SEARCH_VERSION ) {
            my $run = $operations{before}{post_edit}{run};
            $operations{before}{post_edit}{run} = sub {
                ## no critic (TestingAndDebugging::ProhibitNoWarnings Variables::ProtectPrivateVars) -- restore only the pre-101 preflight for this measurement
                no warnings 'redefine';
                local *GPForum::Service::Forum::PostingWorkflow::_post_checked
                  = \&_before_post_checked;
                return $run->();
            };
        }
        for my $name (@PAIRED_OPERATIONS) {
            my %operation = map { $_ => $operations{$_}{$name} } @PAIRED_PATHS;
            my $samples =
              _paired_samples( $name, \%operation, $counts, $option );
            for my $path (@PAIRED_PATHS) {
                $report{operations}{$name}{$path}{$mode} =
                  _paired_summary( $samples->{$path} );
            }
        }
        $schema->storage->disconnect;
    }
    return \%report;
}

# The pre-101 method, with the same function readers and domain refusal.
sub _before_post_checked ( $self, $input, $rule ) {
    my $post = $self->post_reader->find_post( $input->{post_id} );
    my $thread =
      $post
      ? $self->thread_detail_reader->find_thread(
        $post->get_column('thread_id'),
        $input->{viewer} )
      : undef;
    my $error =
      GPForum::Domain::Post->$rule( $post, $thread, $input->{author_user_id} );
    return (
        $post,
        $error
        ? {
            ok     => 0,
            status => GPForum::Domain::Post->status_of($error),
            error  => $error
          }
        : undef
    );
}

sub _paired_samples ( $name, $operations, $counts, $option ) {
    my %samples    = map { $_ => [] } @PAIRED_PATHS;
    my $iterations = _iterations( $operations->{before}, $option );
    for my $pair ( 1 .. $option->{warmup} + $iterations ) {
        my $number =
          $pair <= $option->{warmup} ? $pair : $pair - $option->{warmup};
        my @order = $number % 2 ? @PAIRED_PATHS : reverse @PAIRED_PATHS;
        my %result;
        for my $slot ( 0 .. $#order ) {
            my $path = $order[$slot];
            %{$counts} = ();
            my $processor = clock();
            my $started   = time;
            $result{$path} = $operations->{$path}{run}->();
            my $wall = time - $started;
            my $cpu  = ( clock() - $processor ) / $CLOCKS_PER_SECOND;
            next if $pair <= $option->{warmup};
            my $sample = {
                pair        => $pair - $option->{warmup},
                order       => $slot + 1,
                wall_ms     => $wall * $MILLISECONDS,
                cpu_ms      => $cpu * $MILLISECONDS,
                statements  => $counts->{statements} // 0,
                round_trips => ( $counts->{statements} // 0 ) +
                  ( $counts->{transaction} // 0 ),
            };

            if ( $name eq 'post_edit' ) {
                $sample->{revision_id} = _written_revision( $result{$path} );
            }
            push @{ $samples{$path} }, $sample;
        }
        _check_pair( $name, \%result );
    }
    return \%samples;
}

sub _check_pair ( $name, $result ) {
    if ( $name eq 'post_edit' ) {
        for my $path (@PAIRED_PATHS) {
            croak "$path post edit did not write a revision"
              if !$result->{$path}{ok}
              || $result->{$path}{stored}{skipped}
              || !_written_revision( $result->{$path} );
        }
        croak 'paired post edits did not write distinct revisions'
          if _written_revision( $result->{before} ) eq
          _written_revision( $result->{after} );
        return;
    }
    my $json = JSON::MaybeXS->new( canonical => 1 );
    croak "$name paired search results differ"
      if $json->encode( $result->{before} ) ne
      $json->encode( $result->{after} );
    return;
}

sub _written_revision ($result) {
    my $post = $result->{stored}{post};
    return $post ? $post->get_column('current_revision_id') : undef;
}

sub _paired_summary ($samples) {
    my %total;
    for my $sample ( @{$samples} ) {
        for my $key (qw(cpu_ms statements round_trips)) {
            $total{$key} += $sample->{$key};
        }
    }
    my @wall = map { $_->{wall_ms} } @{$samples};
    return {
        samples   => $samples,
        median_ms => _median(@wall),
        p95_ms    => _percentile( \@wall, $PERCENTILE ),
        map { $_ => ( $total{$_} // 0 ) / ( @{$samples} || 1 ) }
          qw(cpu_ms statements round_trips)
    };
}

# The operations, each a code reference that runs one of them, built as
# Bootstrap::Forum builds the services. The dbic path is the one a schema
# without the function layer takes; the function path the one PostgreSQL
# takes now.
sub _operation_path ( $path, $context ) {
    return ( functions => undef )                 if $path eq 'dbic';
    return ( functions => $context->{functions} ) if $context->{functions};
    return ();
}

sub _operations ( $schema, $path, $context = {} ) {
    my %perl   = _operation_path( $path, $context );
    my $thread = seed_id( thread => 1 );
    my $member = GPForum::Service::Forum::Viewer->new(
        member  => 1,
        user_id => seed_id( user => 2 ),
    );
    my $posts =
      GPForum::Service::Forum::PostReader->new( schema => $schema, %perl );
    my $threads = GPForum::Service::Forum::ThreadDetailReader->new(
        post_reader => $posts,
        schema      => $schema,
        %perl,
    );
    my $workflow = GPForum::Service::Forum::PostingWorkflow->new(
        category_reader => GPForum::Service::Forum::CategoryReader->new(
            schema => $schema,
            %perl
        ),
        command_idempotency =>
          GPForum::Service::Operations::CommandIdempotency->new(
            schema => $schema
          ),
        mention_store =>
          GPForum::Service::Community::MentionStore->new( schema => $schema ),
        post_composer => GPForum::Service::Forum::PostComposer->new,
        post_reader   => $posts,
        post_store    =>
          GPForum::Service::Forum::PostStore->new( schema => $schema, %perl ),
        thread_composer      => GPForum::Service::Forum::ThreadComposer->new,
        thread_detail_reader => $threads,
        thread_store         =>
          GPForum::Service::Forum::ThreadStore->new( schema => $schema, %perl ),
        %perl,
    );
    my $ids = GPForum::Infrastructure::Id->new;
    my ($halfway) =
      $schema->storage->dbh->selectrow_array(
        'SELECT post_id FROM posts WHERE thread_id = ? AND position = ?',
        undef, $thread, $HALFWAY );
    my $deep = encode_base64url("$HALFWAY|$halfway");

    my $categories = GPForum::Service::Forum::CategoryReader->new(
        schema => $schema,
        %perl
    );
    my $lists = GPForum::Service::Forum::ThreadReader->new(
        schema => $schema,
        %perl
    );
    my $home = GPForum::Service::Forum::HomePageReader->new(
        category_reader => $categories,
        thread_reader   => $lists
    );
    my $category = seed_id( category => 1 );
    my $scope    = $member->within( $category, seed_id( space => 1 ) );

    my $sessions = GPForum::Service::Identity::SessionStore->new(
        schema => $schema,
        %perl,
    );
    my $session = $sessions->create_session(
        { id => $member->user_id },
        {
            request_address => '198.51.100.19',
            user_agent      => 'SQL function benchmark'
        }
    );
    my $session_request = {
        session_id    => $session->{session}->get_column('session_id'),
        session_token => $session->{session_token},
        user_id       => $member->user_id,
    };
    my $viewer_resolver = GPForum::Service::Forum::ViewerResolver->new(
        schema => $schema,
        %perl,
    );
    my $participation = GPForum::Service::Moderation::SuspensionStore->new(
        schema => $schema,
        %perl,
    );
    my $permission = GPForum::Service::Admin::PermissionGate->new(
        schema => $schema,
        %perl,
    );
    my $rate_limit =
      GPForum::Service::Operations::RateLimiter::PostgreSQLStore->new(
        schema => $schema,
        %perl,
      );
    $schema->storage->dbh->do( 'DELETE FROM rate_limit_buckets WHERE scope = ?',
        undef, 'sql_fn_bench' );
    my $rate_request = {
        scope    => 'sql_fn_bench',
        action   => 'read',
        actor_id => $member->user_id,
        limit    => 100_000_000,
    };

    my $notifications = GPForum::Service::Notification::Dispatcher->new(
        schema => $schema,
        %perl,
        readability =>
          GPForum::Service::Forum::Readability->new( schema => $schema, %perl )
    );
    if ( !$schema->resultset('NotificationInbox')
        ->search( { recipient_user_id => $member->user_id } )
        ->count )
    {
        for my $index ( 1 .. $NOTIFICATIONS ) {
            $notifications->create_notification(
                {
                    recipient_user_id => $member->user_id,
                    notification_id   => $ids->uuid,
                    source_type       => 'thread',
                    source_id         => $thread,
                    notification_type => 'reply',
                    payload           => { index => $index }
                }
            );
        }
    }

    my $searcher = GPForum::Service::Search::Searcher->new(
        schema => $schema,
        %perl,
        permission_engine => GPForum::Service::Search::PermissionEngine->new,
    );
    my $read_state =
      GPForum::Service::Forum::ReadState->new( schema => $schema, %perl );
    my $operations = {
        %{
            _write_operations(
                $workflow,   $read_state,
                $rate_limit, $rate_request,
                $member,     $thread,
                $halfway,    $category,
                $ids,        $context->{edit_counter}
            )
        },
        search_ranked => {
            kind => 'read',
            run  => sub {
                my $result = $searcher->ranked_search( { viewer => $member },
                    'Depth', { limit => 20 } );
                @{ $result->{results} }
                  or croak 'benchmark search found no documents';
                return $result;
            }
        },
        search_autocomplete => {
            kind => 'read',
            run  => sub {
                my $result = $searcher->autocomplete( { viewer => $member },
                    'Dep', { limit => 10 } );
                @{$result} or croak 'benchmark autocomplete found no documents';
                return $result;
            }
        },
        category_index_member => {
            kind => 'read',
            run  =>
              sub { $categories->list_categories( { viewer => $member } ); },
        },
        category_threads_member => {
            kind => 'read',
            run  => sub {
                $lists->list_category_threads(
                    {
                        category_id    => $category,
                        viewer_scope   => $scope,
                        viewer_user_id => $member->user_id,
                        limit          => 25,
                    }
                );
            },
        },
        latest_threads_member => {
            kind => 'read',
            run  => sub {
                $lists->list_public_threads(
                    { viewer => $member, limit => 25 } );
            },
        },
        home_page_member => {
            kind => 'read',
            run  => sub { $home->home_page( { viewer => $member } ); },
        },
        session_validate => {
            kind => 'read',
            run  => sub {
                $sessions->validate_session($session_request)->{ok}
                  or croak 'benchmark session was refused';
            },
        },
        viewer_resolve => {
            kind => 'read',
            run  => sub {
                $viewer_resolver->resolve( $member->user_id )->member
                  or croak 'benchmark viewer is not a member';
            },
        },
        participation => {
            kind => 'read',
            run  => sub {
                $participation->can_participate( $member->user_id )->{ok}
                  or croak 'benchmark member cannot participate';
            },
        },
        permission_check => {
            kind => 'read',
            run  => sub {
                $permission->allowed( $member->user_id,
                    { resource_type => 'category', action => 'read' } );
            },
        },
        notification_inbox => {
            kind => 'read',
            run  => sub {
                $notifications->list_page_for_user( $member->user_id,
                    { limit => 25, viewer => $member } );
            }
        },
        notification_badge => {
            kind => 'read',
            run  => sub {
                $notifications->unread_count_for_user( $member->user_id,
                    $member );
            }
        },
        thread_page_anonymous => {
            kind => 'read',
            run  => sub {
                $threads->thread_page( { thread_id => $thread } )->{ok}
                  or croak 'no thread page';
            },
        },
        thread_page_member_deep => {
            kind => 'read',
            run  => sub {
                $threads->thread_page(
                    {
                        after          => $deep,
                        thread_id      => $thread,
                        viewer         => $member,
                        viewer_user_id => $member->user_id,
                    }
                )->{ok} or croak 'no thread page';
            },
        },
        thread_page_member => {
            kind => 'read',
            run  => sub {
                $threads->thread_page(
                    {
                        thread_id      => $thread,
                        viewer         => $member,
                        viewer_user_id => $member->user_id,
                    }
                )->{ok} or croak 'no thread page';
            },
        },
    };
    return _with_path( $operations, $path );
}

sub _write_operations (
    $workflow, $read_state, $rate_limit, $rate_request,
    $member,   $thread,     $halfway,    $category,
    $ids,      $edit_counter = undef
  )
{
    my $marked_position =
      $read_state->state_for_thread( $member->user_id, $thread )
      ->{last_read_position};
    my $edit_number = 0;
    $edit_counter //= \$edit_number;
    return {
        mark_read => {
            kind => 'write',
            run  => sub {
                my $result = $read_state->mark_thread_read(
                    {
                        user_id            => $member->user_id,
                        thread_id          => $thread,
                        last_read_position => ++$marked_position
                    }
                );
                $result->{ok} or croak 'benchmark mark read failed';
            }
        },
        post_edit => {
            kind => 'write',
            run  => sub {
                my $result = $workflow->edit_post(
                    {
                        author_user_id => $member->user_id,
                        post_id        => $halfway,
                        command_id     => $ids->uuid,
                        body_source    => 'Bench edit ' . ++${$edit_counter},
                        viewer         => $member
                    }
                );
                $result->{ok} or croak 'benchmark post edit failed';
                return $result;
            }
        },
        rate_limit => {
            kind => 'write',
            run  => sub {
                $rate_limit->check($rate_request)->{ok}
                  or croak 'benchmark rate limiter refused';
            },
        },
        new_thread => {
            kind => 'write',
            run  => sub {
                my $result = $workflow->create_thread(
                    {
                        author_user_id => $member->user_id,
                        body_source    => 'An opening post from the bench.',
                        category_id    => $category,
                        command_id     => $ids->uuid,
                        title          => 'A thread from the bench.',
                        viewer         => $member
                    }
                );
                croak "new thread: $result->{status}" if !$result->{ok};
            }
        },
        reply => {
            kind => 'write',
            run  => sub {
                my $result = $workflow->create_reply(
                    {
                        author_user_id => $member->user_id,
                        body_source    => 'A reply from the bench.',
                        command_id     => $ids->uuid,
                        thread_id      => $thread,
                        viewer         => $member,
                    }
                );
                croak "reply: $result->{status}" if !$result->{ok};
            },
        },
    };
}

sub _with_path ( $operations, $path ) {
    if ( $path eq 'dbic' ) {
        for my $operation ( values %{$operations} ) {
            my $run = $operation->{run};
            $operation->{run} = sub {
                ## no critic (TestingAndDebugging::ProhibitNoWarnings) -- local replacement makes all nested readers use the legacy benchmark path
                no warnings 'redefine';
                local *GPForum::Infrastructure::SqlFunction::for_schema =
                  sub { return undef; };
                return $run->();
            };
        }
    }
    return $operations;
}

# The statements and round trips a handle sends, through DBI's callbacks.
sub _counted ($dbh) {
    my %count;
    $dbh->{Callbacks} = {
        ChildCallbacks => {
            execute => sub { $count{statements}++; return; },
        },
        do => sub { $count{statements}++; return; },
        map {
            ( $_ => sub { $count{transaction}++; return; } )
        } @ROUND_TRIPS,
    };

    return \%count;
}

sub _iterations ( $operation, $option ) {
    return $operation->{kind} eq 'write'
      ? $option->{'write-iterations'}
      : $option->{'read-iterations'};
}

sub _timed ( $operation, $counts, $option ) {
    for ( 1 .. $option->{warmup} ) {
        $operation->{run}->();
    }
    my $iterations = _iterations( $operation, $option );
    %{$counts} = ();
    my @runs;
    my $processor = clock();
    for ( 1 .. $iterations ) {
        my $started = time;
        $operation->{run}->();
        push @runs, time - $started;
    }
    my $processed  = ( clock() - $processor ) / $CLOCKS_PER_SECOND;
    my $statements = ( $counts->{statements} // 0 ) / $iterations;

    return {
        cpu_ms => _ms( $processed / $iterations ),

        median_ms   => _ms( _median(@runs) ),
        p95_ms      => _ms( _percentile( \@runs, $PERCENTILE ) ),
        round_trips => $statements +
          ( $counts->{transaction} // 0 ) / $iterations,
        statements => $statements,
    };
}

# Exclusive time charged to DBIx::Class, to DBI and to the rest, per call,
# with every method of both wrapped while the operation runs.
sub _profiled ( $operation, $option ) {
    my $profile    = GPForum::Benchmark::BucketProfile->new->wrap;
    my $iterations = _iterations( $operation, $option );
    for ( 1 .. $option->{warmup} ) {
        $operation->{run}->();
    }
    my %total;
    for ( 1 .. $iterations ) {
        my $spent = $profile->measure( $operation->{run} );
        for my $bucket ( keys %{$spent} ) {
            $total{$bucket} += $spent->{$bucket};
        }
    }
    $profile->unwrap;

    return {
        map { ( "${_}_ms" => _ms( $total{$_} / $iterations ) ) }
          keys %total
    };
}

sub _median (@values) {
    return _percentile( \@values, 1 / 2 );
}

sub _percentile ( $values, $share ) {
    my @sorted = sort { $a <=> $b } @{$values};
    return 0 if !@sorted;

    return $sorted[ int( $share * $#sorted + 1 / 2 ) ];
}

sub _ms ($seconds) {
    return 0 + sprintf '%.3f', $seconds * $MILLISECONDS;
}

sub _text ($report) {
    return _paired_text($report) if $report->{comparison};
    my $text = sprintf 'SELECT 1: %.3f ms at the database, %.3f ms through'
      . " the proxy (%.2f ms each way)\n\n",
      @{ $report->{round_trip_ms} }{qw(direct proxy)}, $report->{delay_ms};
    $text .= sprintf "%-22s %-9s %8s %8s %8s %8s %8s %8s %8s %6s %6s\n",
      qw(operation path cpu dbic dbi med p95 med_px p95_px stmts rtrips);
    for my $op ( sort keys %{ $report->{operations} } ) {
        for my $path (@PATHS) {
            my $row = $report->{operations}{$op}{$path};
            $text .= sprintf
"%-22s %-9s %8.3f %8.3f %8.3f %8.3f %8.3f %8.3f %8.3f %6.1f %6.1f\n",
              $op, $path, $row->{direct}{cpu_ms},
              $row->{profile}{dbic_ms} // 0,
              $row->{profile}{dbi_ms}  // 0,
              @{ $row->{direct} }{qw(median_ms p95_ms)},
              @{ $row->{proxy} }{qw(median_ms p95_ms)},
              @{ $row->{direct} }{qw(statements round_trips)};
        }
    }

    return $text;
}

sub _paired_text ($report) {
    my $text = "Paired stored-function comparison (alternating order)\n";
    $text .= sprintf "%-22s %-7s %-7s %8s %8s %8s %6s %6s\n",
      qw(operation path mode cpu median p95 stmts trips);
    for my $operation (@PAIRED_OPERATIONS) {
        for my $path (@PAIRED_PATHS) {
            for my $mode (@MODES) {
                my $row = $report->{operations}{$operation}{$path}{$mode};
                $text .=
                  sprintf "%-22s %-7s %-7s %8.3f %8.3f %8.3f %6.1f %6.1f\n",
                  $operation, $path, $mode,
                  @{$row}{qw(cpu_ms median_ms p95_ms statements round_trips)};
            }
        }
    }
    return $text;
}
