%# The posts of a thread: for each, who wrote it and when, what they wrote,
%# and what the reader may do with it. Editing, deleting and reporting each
%# open in a sheet, so the page stays the conversation.
%#
%# A page shows up to 25 posts, so whatever is done for one is done 25 times.
%# What is static -- the author, the labels, each sheet's opening (its
%# button, dialog and heading) -- comes from the fragment cache
%# (GPForum::Web::PostFragments); a sheet's forms and its closing tag are
%# written here, and the time is the ui_timestamp helper rather than the
%# components/timestamp partial.
%#
%# With the page's script each post's forms post in place (hx-boost), and the
%# post comes back as the list now lists it, in its own place (hx-target on
%# the item).
%#
%# Takes "posts"; reads the page's "engagement". What is the same for every
%# post -- the reader's standing, the fragment cache -- is read once, above
%# the loop.
% my $signed_in = $engagement && $engagement->{authenticated};
% my $fragments = ui_presenter->post_fragments;
%# The page's URL for "Copy post link": its path and the parameters that
%# chose the page, not the rest of the query -- a shared render is served to
%# every visitor, and carried the first visitor's.
% my $page_url = do {
%   my $url = $self->req->url->clone;
%   my %kept = map { $_ => 1 } qw(after at limit post quote reply_to);
%   $url->query->remove($_) for grep { !$kept{$_} } @{ $url->query->names };
%   $url->to_string;
% };

% for my $post (@{$posts}) {
%   my $dom_id = 'post-' . $post->{post_id};
%   my $static = $fragments->render($self, $post);
%   my $paths = $static->{paths};
  <li class="ui-card-list__item" hx-target:inherited="this" hx-swap:inherited="outerHTML">
    <article class="post" id="<%= $dom_id %>" data-page-url="<%= $page_url %>" aria-labelledby="<%= $dom_id %>-heading">
      <%= $static->{header} %>
          % if ($post->{created_at}) {
            <span><%= ui_timestamp($post->{created_at}) %></span>
          % }
        </p>
        <%= $static->{permalink} %>
      </header>
      %# ADR 0130: the post of a member the reader ignores or blocks waits
      %# behind a control that shows it, with or without the page's script.
      % if ($post->{ignored}) {
      <details class="post__ignored">
        <summary><%= t('community.relation_collapsed_post') %></summary>
      % }
      <%= $static->{reply} %>
      <div class="forum-post-body"><%== ui_trusted_html($post->{body}, 'forum.post.body') %></div>
      % if ($post->{integrations} && @{ $post->{integrations} }) {
        <%= include 'forum/_integrations', integrations => $post->{integrations} %>
      % }
      <%= $static->{deleted} %>
      % if ($post->{attachments} && @{ $post->{attachments} }) {
        <ul class="post__attachments" aria-label="<%= t('forum.post_attachments') %>">
          % for my $attachment (@{ $post->{attachments} }) {
            <li>
              <%= include 'components/attachment_media', attachment => $attachment, media_url => ui_path('attachment_download', attachment_id => $attachment->{attachment_id}) %>
              <a href="<%= ui_path('attachment_download', attachment_id => $attachment->{attachment_id}) %>"><%= $attachment->{original_filename} %></a>
              <span><%= $attachment->{media_type} %></span>
              % if ($post->{can_edit}) {
                <form method="post" action="<%= ui_path('post_attachment_delete', post_id => $post->{post_id}, attachment_id => $attachment->{attachment_id}) %>">
                  <%= csrf_field %>
                  <input type="hidden" name="command_id" value="<%= $attachment->{delete_command_id} || q{} %>">
                  <button type="submit" class="button--quiet"><%= ui_icon('close') %><%= t('forum.delete_attachment') %></button>
                </form>
              % }
            </li>
          % }
        </ul>
      % }
      % if ($post->{ignored}) {
      </details>
      % }
      % my $like_count = $post->{like_count} || 0;
        <footer class="post__actions">
          % if ($post->{can_like}) {
          %   my $like_route = $post->{liked} ? 'post_unlike' : 'post_like';
            <form method="post" action="<%= $paths->{$like_route} %>" hx-boost="true" hx-push-url="false" hx-sync:inherited="closest form:drop" hx-disable="findAll button[type=submit]:not(:disabled)">
              <%= csrf_field %>
              <input type="hidden" name="command_id" value="<%= $post->{like_command_id} || q{} %>">
              <%= $static->{like} %>
            </form>
          % } elsif ($like_count) {
            <span class="post__likes"><%= tc('forum.like_count', $like_count) %></span>
          % }
          <%= include 'forum/_reactions', post => $post, reaction_paths => $paths %>
          % if ($signed_in && !$post->{deleted_at}) {
            <%= $static->{reply_links} %>
          % }
          <details class="post-tools">
            <summary><%= t('forum.post_tools') %><%= ui_icon('arrow-right') %></summary>
            <div class="post-tools__menu">
              % if ($post->{can_edit}) {
                <a class="button--quiet post__attach" href="<%= $paths->{post_attachment_form} %>"><%= ui_icon('upload') %><%= t('form.attach_file') %></a>
              % }
              <a href="<%= $paths->{post_verification} %>"><%= t('forum.signature_details') %></a>
          % if ($post->{can_edit}) {
            <%= $static->{edit_sheet} %>
              <form method="post" action="<%= $paths->{post_edit} %>" hx-boost="true" hx-push-url="false" hx-sync:inherited="closest form:drop" hx-disable="findAll button[type=submit]:not(:disabled)">
                <%= csrf_field %>
                <input type="hidden" name="command_id" value="<%= $post->{edit_command_id} || q{} %>">
                <label for="<%= $dom_id %>-edit-body"><%= t('forum.edit_body') %></label>
                <textarea id="<%= $dom_id %>-edit-body" name="body_source" rows="10" required><%= $post->{body_source} %></textarea>
                <button type="submit"><%= t('forum.save_edit') %></button>
              </form>
              <form method="post" enctype="multipart/form-data" action="<%= $paths->{post_attachment_upload} %>">
                <%= csrf_field %>
                <input type="hidden" name="command_id" value="<%= $post->{upload_command_id} || q{} %>">
                <%= $static->{upload} %>
              </form>
            </div>
          % }
          % if ($post->{can_delete}) {
            <%= $static->{delete_sheet} %>
              <form method="post" action="<%= $paths->{post_delete} %>" hx-boost="true" hx-push-url="false" hx-sync:inherited="closest form:drop" hx-disable="findAll button[type=submit]:not(:disabled)">
                <%= csrf_field %>
                <input type="hidden" name="command_id" value="<%= $post->{delete_command_id} || q{} %>">
                <%= $static->{remove} %>
              </form>
            </div>
          % }
          % if ($post->{can_restore}) {
            <form method="post" action="<%= $paths->{post_restore} %>" hx-boost="true" hx-push-url="false" hx-sync:inherited="closest form:drop" hx-disable="findAll button[type=submit]:not(:disabled)">
              <%= csrf_field %>
              <input type="hidden" name="command_id" value="<%= $post->{restore_command_id} || q{} %>">
              <button type="submit" class="button--quiet"><%= t('forum.restore_post') %></button>
            </form>
          % }
          % if ($signed_in) {
            <%= $static->{report_sheet} %>
              <form method="post" action="<%= $paths->{post_report} %>" hx-boost="true" hx-push-url="false" hx-sync:inherited="closest form:drop" hx-disable="findAll button[type=submit]:not(:disabled)">
                <%= csrf_field %>
                <input type="hidden" name="command_id" value="<%= $post->{report_command_id} || q{} %>">
                <%= $static->{report} %>
              </form>
            </div>
          % }
            </div>
          </details>
        </footer>
    </article>
  </li>
% }
