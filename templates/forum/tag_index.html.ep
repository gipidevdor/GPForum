% layout 'default';
% title t('forum.tags') . ' - ' . t('app.name');
% stash breadcrumbs => [
%   { current => 0, label => t('nav.home'), url => url_for('home')->to_string },
%   { current => 1, label => t('forum.tags') },
% ];

<section aria-labelledby="tags-heading">
  <%= include 'components/page_header',
    heading_id => 'tags-heading',
    component_title => t('forum.tags'),
    description => t('forum.tags_description') %>
  % if (@{$tags}) {
    <ul class="tag-cloud" aria-label="<%= t('forum.tags') %>">
      % for my $tag (@{$tags}) {
        <li>
          <a class="tag" href="<%= ui_path('tag', slug => $tag->{slug}) %>"><%= $tag->{name} %></a>
          <span class="ui-count"><%= tc('forum.tagged_thread_count', $tag->{thread_count}) %></span>
        </li>
      % }
    </ul>
  % } else {
    <%= include 'components/empty_state',
      heading_id => 'tags-empty-heading',
      component_title => t('forum.no_tags') %>
  % }
</section>
