%# Where a reader can go: the places of the forum, and for a member their own
%# lists. Starting a thread is something to do, so it is a button on the pages
%# that list threads and not a place here. The link to the page being read
%# says so (aria-current), and the stylesheet marks it.
% my $here = current_route() // q{};
% my $current = sub { return $here eq shift ? ' aria-current="page"' : q{} };
<nav class="site-nav" aria-label="<%= t('nav.primary') %>">
  <a href="<%= ui_path('categories') %>"<%== $current->('categories') %>><%= t('nav.categories') %></a>
  <a href="<%= ui_path('tags') %>"<%== $current->('tags') %>><%= t('nav.tags') %></a>
  <a href="<%= ui_path('forum_search') %>"<%== $current->('forum_search') %>><%= t('nav.search') %></a>
  % if (session('user_id')) {
    <a href="<%= ui_path('bookmarks') %>"<%== $current->('bookmarks') %>><%= t('nav.bookmarks') %></a>
    <a href="<%= ui_path('drafts') %>"<%== $current->('drafts') %>><%= t('nav.drafts') %></a>
    <a href="<%= ui_path('feed') %>"<%== $current->('feed') %>><%= t('nav.feed') %></a>
    <a href="<%= ui_path('notifications') %>" data-notification-link data-summary-url="<%= ui_path('notifications_summary') %>" data-notification-label="<%= t('nav.notifications') %>"<% if (ui_realtime_enabled) { %> data-realtime-url="<%= ui_path('realtime') %>" data-realtime-channel="notifications:<%= session('user_id') %>"<% } %><%== defined stash('unread_count') ? ' data-initial-count="' . (0 + stash('unread_count')) . '"' : q{} %><%== $current->('notifications') %>><%= t('nav.notifications') %> <span class="notification-count" data-notification-count aria-hidden="true" hidden></span></a>
    <a href="<%= ui_path('messages') %>"<%== $current->('messages') %>><%= t('nav.messages') %></a>
  % }
</nav>
