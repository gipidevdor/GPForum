--- a/t/863-cache-inflight-invalidation.t
+++ b/t/863-cache-inflight-invalidation.t
@@ -0,0 +1,158 @@
+# SPDX-FileCopyrightText: 2026 GPForum Contributors
+# SPDX-License-Identifier: BSD-3-Clause
+
+package main;
+
+use v5.40;
+
+use Test::More;
+
+use lib 'lib';
+use lib 't/lib';
+
+use GPForum::Infrastructure::PgNotifications;
+use GPForum::Service::Operations::CacheInvalidationBus;
+use GPForum::Service::Operations::LocalCache;
+use GPForum::Service::Operations::SharedCache;
+use GPForum::Service::Operations::TieredCache;
+use GPForum::Test::RealtimeBusDbh;
+use GPForum::Test::RealtimeBusSchema;
+use GPForum::Test::SharedCacheClient;
+
+our $VERSION = '0.001';
+
+sub _cache ($shared) {
+    my $backing =
+      $shared
+      ? GPForum::Service::Operations::SharedCache->new(
+        client => GPForum::Test::SharedCacheClient->new )
+      : GPForum::Service::Operations::LocalCache->new;
+    return GPForum::Service::Operations::TieredCache->new(
+        l1 => GPForum::Service::Operations::LocalCache->new,
+        l2 => $backing,
+    );
+}
+
+sub _invalidate ( $cache, $kind ) {
+    return $cache->invalidate('page')            if $kind eq 'key';
+    return $cache->invalidate_tag('public')      if $kind eq 'tag';
+    return $cache->invalidate_tags( ['public'] ) if $kind eq 'tags';
+    return $cache->clear;
+}
+
+for my $shared ( 0, 1 ) {
+    for my $kind (qw(key tag tags clear)) {
+        subtest "a $kind purge retires a fill with shared=$shared" => sub {
+            my $cache = _cache($shared);
+            is(
+                $cache->get_or_set(
+                    'page',
+                    sub {
+                        _invalidate( $cache, $kind );
+                        return 'old page';
+                    },
+                    { tags => ['public'] }
+                ),
+                'old page',
+                'the current caller still receives its computed result'
+            );
+            is( $cache->l1->get('page'), undef,
+                'L1 cannot retain that result' );
+            is( $cache->l2->get('page'), undef,
+                'L2 cannot retain that result' );
+            is( $cache->snapshot->{stats}{writes}, 0, 'no fill was admitted' );
+            is(
+                $cache->get_or_set(
+                    'page',
+                    sub { return 'fresh page' },
+                    { tags => ['public'] }
+                ),
+                'fresh page',
+                'a subsequent fill uses the current generation'
+            );
+            is( $cache->get('page'), 'fresh page', 'that fill remains cached' );
+        };
+    }
+}
+
+for my $kind (qw(key tag clear)) {
+    subtest
+      "a remote $kind purge consumed by a nested read retires the fill" => sub {
+        my $cache   = _cache(1);
+        my $backend = GPForum::Test::RealtimeBusDbh->new;
+        my $peer    = GPForum::Test::RealtimeBusDbh->new( pg_pid => 1 )
+          ->join_network($backend);
+        my $schema = GPForum::Test::RealtimeBusSchema->new( dbh => $backend );
+        $cache->bus(
+            GPForum::Service::Operations::CacheInvalidationBus->new(
+                schema => $schema
+            )
+        );
+        my $publisher = GPForum::Service::Operations::CacheInvalidationBus->new(
+            schema => GPForum::Test::RealtimeBusSchema->new( dbh => $peer ) );
+        my $request =
+            $kind eq 'key' ? { keys => ['page'] }
+          : $kind eq 'tag' ? { tags => ['public'] }
+          :                  { clear => 1 };
+
+        $cache->get_or_set(
+            'page',
+            sub {
+                _invalidate( $cache->l2, $kind );
+                ok( $publisher->publish($request),
+                    'another backend publishes' );
+                is( $cache->get('nested'),
+                    undef, 'a nested read consumes the pending purge' );
+                return 'old page';
+            },
+            { tags => ['public'] }
+        );
+        is_deeply( $cache->bus->drain, [], 'the purge will not arrive again' );
+        is( $cache->get('page'), undef,
+            'the completed stale fill cannot resurrect after the purge' );
+        is( $cache->l2->get('page'), undef, 'neither layer admits it' );
+      };
+}
+
+for my $shared ( 0, 1 ) {
+    subtest "an explicit page ticket covers a purge with shared=$shared" =>
+      sub {
+        my $cache  = _cache($shared);
+        my $ticket = $cache->ticket( ['public'], { mint => 1 } );
+        $cache->invalidate('page');
+        is(
+            $cache->put(
+                'page', 'old page', { tags => ['public'], ticket => $ticket }
+            ),
+            'old page',
+            'put preserves its return contract'
+        );
+        is( $cache->get('page'), undef,
+            'a retired ticket admits neither layer' );
+
+        my $raw_ticket =
+            $shared
+          ? $cache->l2->ticket( ['public'], { mint => 1 } )
+          : $cache->ticket( ['public'] );
+        $cache->put( 'page', 'fresh page',
+            { tags => ['public'], ticket => $raw_ticket } );
+        is( $cache->get('page'), 'fresh page',
+            'raw shared tickets remain supported' );
+      };
+}
+
+subtest 'an empty tag purge does not discard a valid fill' => sub {
+    my $cache = _cache(0);
+    $cache->get_or_set(
+        'page',
+        sub {
+            $cache->invalidate_tags( [] );
+            return 'fresh page';
+        }
+    );
+    is( $cache->get('page'), 'fresh page', 'a no-op does not retire a fill' );
+};
+
+done_testing();
+
+1;
--- a/t/864-pg-notification-read-contract.t
+++ b/t/864-pg-notification-read-contract.t
@@ -0,0 +1,149 @@
+# SPDX-FileCopyrightText: 2026 GPForum Contributors
+# SPDX-License-Identifier: BSD-3-Clause
+
+package main;
+
+use v5.40;
+
+use Test::More;
+
+use lib 'lib';
+use lib 't/lib';
+
+use GPForum::Infrastructure::PgNotifications;
+use GPForum::Test::RealtimeBusDbh;
+use GPForum::Test::RealtimeBusSchema;
+use GPForum::Test::ReplacedSubs qw(with_replaced_subs);
+
+our $VERSION = '0.001';
+
+sub _queue {
+    my $schema = GPForum::Test::RealtimeBusSchema->new(
+        dbh => GPForum::Test::RealtimeBusDbh->new );
+    my $queue =
+      GPForum::Infrastructure::PgNotifications->new( schema => $schema );
+    $queue->listen_to('cache');
+    $queue->listen_to('domain');
+    return ( $queue, $schema );
+}
+
+for my $failure (qw(exception dbi_error)) {
+    subtest "a repeated $failure read failure makes every consumer stale" =>
+      sub {
+        my ( $queue, $schema ) = _queue();
+        my $attempts = 0;
+        with_replaced_subs(
+            'GPForum::Test::RealtimeBusDbh',
+            {
+                pg_notifies => sub {
+                    $attempts += 1;
+                    die "socket closed\n" if $failure eq 'exception';
+                    return undef;
+                },
+                err => sub { return 1 },
+            },
+            sub {
+                my $taken = $queue->take('cache');
+                ok( !$taken->{available}, 'a failed retry is unavailable' );
+                ok( $taken->{gap},
+                    'the current consumer learns it lost coverage' );
+                is( $attempts, 2,
+                    'only one reconnect/read retry is attempted' );
+                ok( !$queue->listening('cache'),
+                    'the failed channel is stale' );
+                ok(
+                    !$queue->listening('domain'),
+                    'other channels are also stale'
+                );
+            }
+        );
+        my $recovered = $queue->take('cache');
+        ok( $recovered->{available}, 'a healthy read recovers' );
+        ok( $recovered->{gap},
+            'recovery on the same handle still reports the gap' );
+        ok( $queue->listening('domain'), 'every channel is registered again' );
+        ok(
+            $queue->take('domain')->{gap},
+            'the other consumer retains its gap'
+        );
+        ok(
+            !$queue->take('cache')->{gap},
+            'a healthy idle read has no new gap'
+        );
+      };
+}
+
+subtest 'losing the storage handle retires established listeners' => sub {
+    my ( $queue, $schema ) = _queue();
+    my $backend = $schema->dbh;
+    $schema->dbh(undef);
+    my $taken = $queue->take('cache');
+    ok( !$taken->{available}, 'the absent handle is unavailable' );
+    ok( $taken->{gap}, 'the cache must distrust its old values immediately' );
+    ok( !$queue->listening('domain'),
+        'the other listener is no longer current' );
+    $schema->dbh($backend);
+    ok( $queue->take('domain')->{gap}, 'coverage is restored with a gap' );
+};
+
+subtest 'a successful retry on the same handle still reports lost coverage' =>
+  sub {
+    my ( $queue, $schema ) = _queue();
+    my $attempts = 0;
+    with_replaced_subs(
+        'GPForum::Test::RealtimeBusDbh',
+        {
+            pg_notifies => sub {
+                die "socket temporarily unreadable\n" if ++$attempts == 1;
+                return undef;
+            },
+        },
+        sub {
+            my $taken = $queue->take('cache');
+            ok( $taken->{available}, 'the retry reads successfully' );
+            ok( $taken->{gap}, 'the failed read still retires cached state' );
+            ok( $queue->take('domain')->{gap},
+                'the other consumer also learns of the lost coverage' );
+        }
+    );
+  };
+
+subtest 'healthy idle polls read without reconnecting or reissuing LISTEN' =>
+  sub {
+    my ( $queue, $schema ) = _queue();
+    my $reads = 0;
+    my $read  = GPForum::Test::RealtimeBusDbh->can('pg_notifies');
+    with_replaced_subs(
+        'GPForum::Test::RealtimeBusDbh',
+        {
+            pg_notifies => sub {
+                $reads += 1;
+                return $read->(@_);
+            },
+        },
+        sub {
+            with_replaced_subs(
+                'GPForum::Infrastructure::Storage',
+                { dbh_of => sub { die "unexpected ping/reconnect\n" } },
+                sub {
+                    ok( $queue->take('cache')->{available}, 'the cache polls' );
+                    ok( $queue->take('domain')->{available},
+                        'the other consumer polls' );
+                }
+            );
+        }
+    );
+    is( $reads, 2, 'both polls still read pending notifications' );
+    is( scalar @{ $schema->dbh->statements },
+        2, 'only the initial LISTENs ran' );
+    ok(
+        $queue->listen_to('new_channel'),
+        'a later registration is synchronized'
+    );
+    is( scalar @{ $schema->dbh->statements },
+        1 + 2, 'existing channels need no new LISTEN' );
+  };
+
+done_testing();
+
+1;
