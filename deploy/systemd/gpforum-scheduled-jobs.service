[Unit]
Description=GPForum scheduled operational jobs
After=network-online.target postgresql.service gpforum.service
Wants=network-online.target

[Service]
Type=oneshot
User=gpforum
Group=gpforum
UMask=0027
WorkingDirectory=/opt/gpforum
# The mode, then the operator's settings. Every other setting keeps the
# default GPForum::Config gives it: a value restated here would stay behind
# when that default changes. Put an override in the env file.
Environment=GPFORUM_ENV=production
EnvironmentFile=/etc/gpforum/gpforum.env
# Application logs have a stable destination independent of journal capture.
Environment=GPFORUM_LOG_PATH=/var/log/gpforum/scheduled-jobs.log
# bin/gpforum finds the Perl and the dependencies this checkout installed.
ExecStart=/opt/gpforum/bin/gpforum scheduled-jobs --once --limit 100
Nice=10
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/gpforum
