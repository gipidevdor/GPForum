% layout 'default';
% title t('forum.tagged_threads', { name => $tag->{name} }) . ' - ' . t('app.name');
% stash breadcrumbs => [
%   { current => 0, label => t('nav.home'), url => url_for('home')->to_string },
%   { current => 0, label => t('forum.tags'), url => url_for('tags')->to_string },
%   { current => 1, label => $tag->{name} },
% ];

<section aria-labelledby="tag-heading">
  <%= include 'components/page_header',
    heading_id => 'tag-heading',
    eyebrow => t('forum.tag'),
    component_title => $tag->{name},
    description => $category ? t('forum.tag_in_category', { category => $category->{title} }) : t('forum.tag_in_all_categories'),
    actions_label => t('forum.tag_actions'),
    actions => ui_actions(
      $category
      ? {
          href => ui_path('tag', slug => $tag->{slug}),
          label => t('forum.tag_in_all_categories'),
        }
      : (),
    ) %>
  % if (@{$threads}) {
    <ol class="ui-card-list" aria-label="<%= t('forum.tagged_threads', { name => $tag->{name} }) %>">
      % for my $thread (@{$threads}) {
        <li class="ui-card-list__item ui-row">
          <h2 class="ui-row__title">
            <a href="<%= ui_path('thread', thread_id => $thread->{thread_id}) %>"><%= $thread->{title} %></a>
            % if ($thread->{pinned}) {
              <%= include 'components/badge', label => t('forum.pinned') %>
            % }
          </h2>
          <%= include 'forum/_tag_list', tags => $thread->{tags} %>
          <p class="ui-meta">
            % if ($thread->{category_title}) {
              <span><a href="<%= url_for('tag', slug => $tag->{slug})->query(category => $thread->{category_id}) %>"><%= $thread->{category_title} %></a></span>
            % }
            % if ($thread->{author_username}) {
              <span>
                <%= t('forum.started_by') %>
                <a href="<%= ui_path('profile', username => $thread->{author_username}) %>"><%= $thread->{author_display_name} || $thread->{author_profile_label} %></a>
              </span>
            % }
            % if (defined $thread->{reply_count}) {
              <span class="ui-count"><%= tc('forum.reply_count', $thread->{reply_count}) %></span>
            % }
            <span>
              <%= t('forum.last_activity') %>
              <%= include 'components/timestamp', at => $thread->{last_activity_at}, missing => t('state.unknown') %>
            </span>
          </p>
        </li>
      % }
    </ol>
  % } else {
    <%= include 'components/empty_state',
      heading_id => 'tag-empty-heading',
      component_title => t('forum.no_tagged_threads') %>
  % }
</section>
