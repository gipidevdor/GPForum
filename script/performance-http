use v5.40;
use Carp    qw(croak);
use English qw(-no_match_vars);
our $VERSION = '0.001';
use FindBin;
use lib "$FindBin::Bin/lib";
use GPForum::Performance::HTTP qw(main);
try { exit main(@ARGV) } catch ($error) {
    require GPForum::Performance::Support;
    print {*STDERR} GPForum::Performance::Support::redact($error)
      or croak "Cannot report error: $ERRNO";
    exit 2;
};
