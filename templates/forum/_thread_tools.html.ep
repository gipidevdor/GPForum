%# What a reader can do with a thread, on one quiet line under its title:
%# reply and finding a place in it. Follow, bookmark, polls, export and
%# the other actions wait in the "Thread tools" sheet: marking as read, muting, reporting and, for the
%# author, the title, the category and deletion; for staff, pinning,
%# locking and hiding, each with the reason the audit log keeps. Going to what is unread is
%# a place in the page, so it is a link in the line above, not an action.
%#
%# With the page's script each form posts in place (hx-boost) and the bar
%# comes back as it then is; "swap_oob" marks a copy sent to replace it.
%#
%# Takes "can_reply"; reads the page's "thread", "reading" and "engagement".
% my $thread_id = $thread->{thread_id};
% my $reads = $reading && $reading->{authenticated};
% my $signed_in = $engagement && $engagement->{authenticated};
% my $engagement_ready = $signed_in && ($engagement->{status} // q{}) ne 'degraded';
% my $bookmark = $signed_in && $engagement->{bookmark} || {};
% my $subscription = $signed_in && $engagement->{subscription} || {};

<div class="toolbar" id="thread-toolbar" hx-target:inherited="#thread-toolbar" hx-swap:inherited="outerHTML"<%== stash('swap_oob') ? ' hx-swap-oob="true"' : q{} %>>
  % if ($can_reply) {
    <a class="button thread-reply" href="#reply-body"><%= ui_icon('reply') %><%= t('forum.reply') %></a>
  % }
    <button type="button" class="button--quiet" popovertarget="thread-tools" aria-label="<%= t('forum.thread_tools') %>"><%= ui_icon('more') %><%= t('forum.thread_options') %></button>
    <%= include 'components/sheet', sheet_id => 'thread-tools', component_title => t('forum.thread_tools'), sheet_body => begin %>
      % if ($engagement_ready) {
        <section aria-labelledby="engagement-heading">
          <h2 class="visually-hidden" id="engagement-heading"><%= t('forum.thread_tools') %></h2>
          % if ($subscription->{subscribed}) {
            <form method="post" action="<%= ui_path('thread_unsubscribe', thread_id => $thread_id) %>" hx-boost="true" hx-push-url="false" hx-sync:inherited="closest form:drop" hx-disable="findAll button[type=submit]:not(:disabled)">
              <%= csrf_field %>
              <input type="hidden" name="command_id" value="<%= $engagement->{unsubscribe_command_id} || q{} %>">
              <button type="submit" class="button--quiet"><%= ui_icon('bell') %><%= t('community.unfollow_thread') %></button>
            </form>
          % } else {
            <form method="post" action="<%= ui_path('thread_subscribe', thread_id => $thread_id) %>" hx-boost="true" hx-push-url="false" hx-sync:inherited="closest form:drop" hx-disable="findAll button[type=submit]:not(:disabled)">
              <%= csrf_field %>
              <input type="hidden" name="command_id" value="<%= $engagement->{subscribe_command_id} || q{} %>">
              <input type="hidden" name="preference" value="all">
              <button type="submit" class="button--quiet"><%= ui_icon('bell') %><%= t('community.follow_thread') %></button>
            </form>
          % }
          % if ($bookmark->{bookmarked}) {
            <form method="post" action="<%= ui_path('thread_bookmark_remove', thread_id => $thread_id) %>" hx-boost="true" hx-push-url="false" hx-sync:inherited="closest form:drop" hx-disable="findAll button[type=submit]:not(:disabled)">
              <%= csrf_field %>
              <input type="hidden" name="command_id" value="<%= $engagement->{bookmark_remove_command_id} || q{} %>">
              <button type="submit" class="button--quiet"><%= ui_icon('bookmark') %><%= t('community.remove_bookmark') %></button>
            </form>
          % } else {
            <button type="button" class="button--quiet" popovertarget="thread-bookmark"><%= ui_icon('bookmark') %><%= t('community.save_bookmark') %></button>
            <%= include 'components/sheet', sheet_id => 'thread-bookmark', component_title => t('community.save_bookmark'), sheet_body => begin %>
              <form method="post" action="<%= ui_path('thread_bookmark', thread_id => $thread_id) %>" hx-boost="true" hx-push-url="false" hx-sync:inherited="closest form:drop" hx-disable="findAll button[type=submit]:not(:disabled)">
                <%= csrf_field %>
                <input type="hidden" name="command_id" value="<%= $engagement->{bookmark_command_id} || q{} %>">
                <label for="bookmark-note"><%= t('community.bookmark_note') %></label>
                <input id="bookmark-note" name="note" type="text" value="">
                <label for="bookmark-folder"><%= t('community.bookmark_folder') %></label>
                <input id="bookmark-folder" name="folder" type="text" value="" autocomplete="off" aria-describedby="bookmark-folder-hint">
                <p class="ui-hint" id="bookmark-folder-hint"><%= t('community.bookmark_folder_hint') %></p>
                <button type="submit"><%= ui_icon('bookmark') %><%= t('community.save_bookmark') %></button>
              </form>
            <% end %>
          % }
        </section>
      % } elsif ($signed_in) {
        <%= include 'components/alert', tone => 'warning', message => t('community.engagement_unavailable') %>
      % }
      <p class="ui-row-links">
  <a class="button--quiet" href="<%= ui_path('thread_poll', thread_id => $thread_id) %>"><%= t('forum.poll') %></a>
  <a class="button--quiet" href="<%= ui_path('thread_mbox', thread_id => $thread->{thread_id}) %>" download><%= t('forum.download_mbox') %></a>
      </p>
      % if ($reads) {
        <section class="sheet__part" aria-labelledby="reading-heading">
          <h3 id="reading-heading"><%= t('forum.reading_progress') %></h3>
          % if (!$reading->{first_unread_anchor}) {
            <p class="sheet__consequence"><%= t('forum.reading_caught_up') %></p>
          % }
          <form method="post" action="<%= ui_path('thread_mark_read', thread_id => $thread_id) %>" hx-boost="true" hx-push-url="false" hx-sync:inherited="closest form:drop" hx-disable="findAll button[type=submit]:not(:disabled)">
            <%= csrf_field %>
            <input type="hidden" name="command_id" value="<%= $reading->{read_command_id} || q{} %>">
            <input type="hidden" name="last_read_position" value="<%= $reading->{last_visible_position} // 0 %>">
            <button type="submit" class="button--secondary"><%= ui_icon('check') %><%= t('forum.mark_visible_posts_read') %></button>
          </form>
        </section>
      % }
      % if ($engagement_ready && $subscription->{subscribed} && !$subscription->{muted}) {
        <details class="sheet__part sheet__disclosure">
          <summary><h3 id="thread-mute-heading"><%= t('nav.notifications') %></h3><%= ui_icon('arrow-right') %></summary>
          <form method="post" action="<%= ui_path('thread_subscription_mute', thread_id => $thread_id) %>" hx-boost="true" hx-push-url="false" hx-sync:inherited="closest form:drop" hx-disable="findAll button[type=submit]:not(:disabled)">
            <%= csrf_field %>
            <input type="hidden" name="command_id" value="<%= $engagement->{mute_command_id} || q{} %>">
            <button type="submit" class="button--secondary"><%= ui_icon('bell') %><%= t('community.mute_notifications') %></button>
          </form>
        </details>
      % }
      % if ($thread->{can_edit_thread}) {
        <details class="sheet__part sheet__disclosure">
          <summary><h3 id="thread-edit-heading"><%= t('forum.edit_title') %></h3><%= ui_icon('arrow-right') %></summary>
          <form method="post" action="<%= ui_path('thread_edit', thread_id => $thread_id) %>" hx-boost="true" hx-push-url="false" hx-sync:inherited="closest form:drop" hx-disable="findAll button[type=submit]:not(:disabled)" hx-target="#thread-header">
            <%= csrf_field %>
            <input type="hidden" name="command_id" value="<%= $thread->{edit_thread_command_id} || q{} %>">
            <label for="thread-edit-title"><%= t('forum.thread_title') %></label>
            <input id="thread-edit-title" name="title" type="text" required value="<%= $thread->{title} %>">
            <label for="thread-edit-tags"><%= t('forum.tags') %></label>
            <input id="thread-edit-tags" name="tags" type="text" autocomplete="off" aria-describedby="thread-edit-tags-hint" value="<%= join q{, }, map { $_->{name} } @{ $thread->{tags} || [] } %>">
            <p class="ui-hint" id="thread-edit-tags-hint"><%= t('forum.tags_hint') %></p>
            <button type="submit" class="button--secondary"><%= ui_icon('check') %><%= t('forum.save_title') %></button>
          </form>
        </details>
        <details class="sheet__part sheet__disclosure">
          <summary><h3 id="thread-move-heading"><%= t('forum.move_thread') %></h3><%= ui_icon('arrow-right') %></summary>
          <form method="post" action="<%= ui_path('thread_move', thread_id => $thread_id) %>" hx-boost="true" hx-push-url="false" hx-sync:inherited="closest form:drop" hx-disable="findAll button[type=submit]:not(:disabled)" hx-target="#thread-header">
            <%= csrf_field %>
            <input type="hidden" name="command_id" value="<%= $thread->{move_thread_command_id} || q{} %>">
            <label for="thread-move-category"><%= t('search.category') %></label>
            <select id="thread-move-category" name="category_id" required>
              % for my $category (@{ $thread->{move_categories} || [] }) {
                <option value="<%= $category->{category_id} %>"<%= ($category->{category_id} || q{}) eq ($thread->{category_id} || q{}) ? ' selected' : '' %>><%= $category->{title} %></option>
              % }
            </select>
            <button type="submit" class="button--secondary"><%= ui_icon('arrow-right') %><%= t('forum.move_thread') %></button>
          </form>
        </details>
      % }
      % if ($signed_in) {
        <details class="sheet__part sheet__disclosure">
          <summary><h3 id="thread-report-heading"><%= t('moderation.report_thread') %></h3><%= ui_icon('arrow-right') %></summary>
          <%= include 'forum/_report_form',
            post_to => ui_path('thread_report', thread_id => $thread_id),
            report_target => '#thread-toolbar',
            command_id => $engagement->{thread_report_command_id},
            field_id => 'thread-report' %>
        </details>
      % }
      % if ($thread->{can_edit_thread}) {
        <details class="sheet__part sheet__disclosure">
          <summary><h3 id="thread-delete-heading"><%= t('forum.delete_thread') %></h3><%= ui_icon('arrow-right') %></summary>
          <form method="post" action="<%= ui_path('thread_delete', thread_id => $thread_id) %>" hx-boost="true" hx-push-url="false" hx-sync:inherited="closest form:drop" hx-disable="findAll button[type=submit]:not(:disabled)" hx-target="#thread-header">
            <%= csrf_field %>
            <input type="hidden" name="command_id" value="<%= $thread->{delete_thread_command_id} || q{} %>">
            <p class="sheet__consequence"><%= t('forum.delete_thread_consequence') %></p>
            <button type="submit" class="button--danger"><%= ui_icon('warning') %><%= t('forum.delete_thread') %></button>
          </form>
        </details>
      % }
      % if ($thread->{can_moderate_thread}) {
        % my $ids = $thread->{moderation_command_ids} || {};
        % my $return_to = ui_path('thread', thread_id => $thread_id);
        % my $pinned = $thread->{pinned} ? 1 : 0;
        % my $locked = $thread->{locked_at} ? 1 : 0;
        <details class="sheet__part sheet__disclosure">
          <summary><h3 id="thread-moderation-heading"><%= t('moderation.thread_actions') %></h3><%= ui_icon('arrow-right') %></summary>
          <p><a href="<%= url_for('moderation_transfers')->query(source => ui_path('thread',thread_id => $thread_id)) %>"><%= t('moderation.organize') %></a></p>
          <form method="post" action="<%= ui_path($pinned ? 'moderation_thread_unpin' : 'moderation_thread_pin', thread_id => $thread_id) %>">
            <%= csrf_field %>
            <input type="hidden" name="command_id" value="<%= $ids->{pin} || q{} %>">
            <input type="hidden" name="return_to" value="<%= $return_to %>">
            <p class="sheet__consequence"><%= t($pinned ? 'moderation.unpin_hint' : 'moderation.pin_hint') %></p>
            <label for="thread-pin-reason"><%= t('moderation.staff_reason') %></label>
            <input id="thread-pin-reason" name="reason" type="text" required>
            <button type="submit" class="button--secondary"><%= t($pinned ? 'moderation.unpin_thread' : 'moderation.pin_thread') %></button>
          </form>
          <form method="post" action="<%= ui_path($locked ? 'moderation_thread_unlock' : 'moderation_thread_lock', thread_id => $thread_id) %>">
            <%= csrf_field %>
            <input type="hidden" name="command_id" value="<%= $ids->{lock} || q{} %>">
            <input type="hidden" name="return_to" value="<%= $return_to %>">
            <p class="sheet__consequence"><%= t($locked ? 'moderation.unlock_hint' : 'moderation.lock_hint') %></p>
            <label for="thread-lock-reason"><%= t('moderation.staff_reason') %></label>
            <input id="thread-lock-reason" name="reason" type="text" required>
            <button type="submit" class="button--secondary"><%= t($locked ? 'moderation.unlock_thread' : 'moderation.lock_thread') %></button>
          </form>
          % if (($thread->{moderation_state} || q{}) ne 'hidden') {
            <form method="post" action="<%= ui_path('moderation_thread_hide', thread_id => $thread_id) %>">
              <%= csrf_field %>
              <input type="hidden" name="command_id" value="<%= $ids->{hide} || q{} %>">
              <input type="hidden" name="return_to" value="<%= $return_to %>">
              <p class="sheet__consequence"><%= t('moderation.hide_hint') %></p>
              <label for="thread-hide-reason"><%= t('moderation.staff_reason') %></label>
              <input id="thread-hide-reason" name="reason" type="text" required>
              <button type="submit" class="button--danger"><%= ui_icon('warning') %><%= t('moderation.hide_thread') %></button>
            </form>
          % }
        </details>
      % }
    <% end %>
  <button type="button" class="button--quiet" popovertarget="thread-explore" aria-label="<%= t('forum.explore_thread') %>"><%= ui_icon('search') %><%= t('forum.explore_short') %></button>
  <%= include 'components/sheet', sheet_id => 'thread-explore', component_title => t('forum.explore_thread'), sheet_body => begin %>
    <p class="ui-row-links">
      <a href="<%= ui_path('thread', thread_id => $thread->{thread_id}) %>"><%= t('forum.first_message') %></a>
      % if ($reading && $reading->{authenticated} && ($reading->{last_read_position} // 0) > 0) {
        <a href="<%= url_for('thread', thread_id => $thread->{thread_id})->query(at => $reading->{last_read_position}) %>"><%= t('forum.resume_reading') %></a>
      % }
    </p>
    <form method="get" action="<%= ui_path('thread', thread_id => $thread->{thread_id}) %>">
      <label for="thread-position"><%= t('forum.jump_position') %></label>
      <input id="thread-position" name="at" type="number" min="1" max="999999999999999999" step="1" required inputmode="numeric" aria-describedby="thread-position-hint">
      <p class="ui-hint" id="thread-position-hint"><%= t('forum.jump_position_hint') %></p>
      <button type="submit"><%= ui_icon('arrow-right') %><%= t('forum.jump_submit') %></button>
    </form>
    <form method="get" action="<%= ui_path('forum_search') %>" role="search">
      <input type="hidden" name="thread_id" value="<%= $thread->{thread_id} %>">
      <input type="hidden" name="scope" value="posts">
      <label for="thread-search"><%= t('search.within_thread') %></label>
      <input id="thread-search" name="q" type="search" required maxlength="500">
      <button type="submit"><%= ui_icon('search') %><%= t('search.submit') %></button>
    </form>
  <% end %>
</div>
